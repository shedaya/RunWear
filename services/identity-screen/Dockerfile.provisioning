# RunWear identity-screen — production image (RW-16.30 provisioning package)
#
# Wraps the in-repo service UNMODIFIED. Build context is the repo's
# services/identity-screen/ directory (app.py + requirements.txt are
# copied from there verbatim). Differences from the in-repo Dockerfile:
#   1. a HEALTHCHECK on the service's own /health endpoint.
# The model weights (YuNet + SFace, ~39 MB total) are downloaded at
# BUILD time with sha256 pins in both Dockerfiles, so a machine start
# is just the model load. (The buffalo_l image this replaces baked
# ~326 MB of InsightFace weights via a prepare() download step; the
# 2026-11-03 swap removed that step together with the stack.)
#
# SCREEN_KEY is a runtime env var (set as a host secret) — never bake
# it into the image. app.py enforces it as a Bearer token on all POSTs.
# IDENTITY_THRESHOLD is likewise a runtime env var (default 0.42).
FROM python:3.12-slim
WORKDIR /srv
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libgl1 curl && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app.py .
RUN mkdir -p models \
 && curl -fsSL -o models/face_detection_yunet_2023mar.onnx \
      https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx \
 && echo "8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4  models/face_detection_yunet_2023mar.onnx" | sha256sum -c - \
 && curl -fsSL -o models/face_recognition_sface_2021dec.onnx \
      https://github.com/opencv/opencv_zoo/raw/main/models/face_recognition_sface/face_recognition_sface_2021dec.onnx \
 && echo "0ba9fbfa01b5270c96627c4ef784da859931e02f04419c829e83484087c34e79  models/face_recognition_sface_2021dec.onnx" | sha256sum -c -
ENV PORT=8080
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s \
  CMD curl -fs http://127.0.0.1:8080/health || exit 1
CMD ["python", "app.py"]
