    "widget_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your outfit for the weather right now, from your last RunWear recommendation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu conjunto para el tiempo de ahora, de tu última recomendación de RunWear."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua roupa para o clima agora, da sua última recomendação do RunWear."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Outfit für das Wetter gerade jetzt, aus deiner letzten RunWear-Empfehlung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre tenue pour la météo actuelle, depuis votre dernière recommandation RunWear."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo outfit per il meteo di adesso, dall'ultimo consiglio di RunWear."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je outfit voor het weer van dit moment, uit je laatste RunWear-aanbeveling."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近のRunWearのおすすめから、今の天気に合ったコーディネート。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 RunWear 추천을 바탕으로, 지금 날씨에 맞는 아웃핏."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你上次的 RunWear 推荐，为现在的天气准备的穿搭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前天氣的裝扮，來自你上次的 RunWear 推薦。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إطلالتك للطقس الآن، من أحدث توصية من RunWear."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी के मौसम के लिए आपकी आउटफ़िट, आपकी अंतिम RunWear सिफ़ारिश से।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Outfitmu untuk cuaca saat ini, dari rekomendasi RunWear terakhirmu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anki hava durumuna uygun kombinin, son RunWear önerinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój strój na obecną pogodę, z Twojej ostatniej rekomendacji RunWear."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш комплект для погоды прямо сейчас, из вашей последней рекомендации RunWear."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din outfit för vädret just nu, från din senaste RunWear-rekommendation."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชุดของคุณสำหรับสภาพอากาศตอนนี้ จากคำแนะนำล่าสุดของ RunWear"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang phục của bạn cho thời tiết ngay bây giờ, từ gợi ý RunWear gần nhất của bạn."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш образ для поточної погоди, з вашої останньої рекомендації RunWear."
          }
        }
      }
    },
