    "wear_permission_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear needs your location for weather-based outfit recommendations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear necesita tu ubicación para las recomendaciones de conjuntos según el tiempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O RunWear precisa da sua localização para recomendações de roupas baseadas no clima."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear braucht deinen Standort für wetterbasierte Outfit-Empfehlungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear a besoin de votre localisation pour des recommandations de tenue basées sur la météo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear ha bisogno della tua posizione per consigli di outfit basati sul meteo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear heeft je locatie nodig voor outfitadviezen op basis van het weer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWearは、天気に基づくコーディネートのおすすめのために位置情報が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear는 날씨 기반 아웃핏 추천을 위해 위치가 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear 需要你的位置来进行基于天气的穿搭推荐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear 需要你的位置，才能提供依天氣的裝扮推薦。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج RunWear إلى موقعك لتوصيات إطلالات مبنية على الطقس."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौसम-आधारित आउटफ़िट सिफ़ारिशों के लिए RunWear को आपके स्थान की ज़रूरत है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear membutuhkan lokasimu untuk rekomendasi outfit berdasarkan cuaca."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear, hava durumuna dayalı kombin önerileri için konumuna ihtiyaç duyar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear potrzebuje Twojej lokalizacji do rekomendacji strojów opartych na pogodzie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear нужна ваша геолокация для рекомендаций комплектов на основе погоды."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear behöver din plats för väderbaserade outfitrekommendationer."
          }
        },
        "th": {
