    "mim_first_look_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your look couldn't be made from these photos. No free look was used — your outfit is ready either way, and you can try again from there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu look no se pudo crear a partir de estas fotos. No se ha usado ningún look gratuito: tu conjunto está listo en cualquier caso, y puedes intentarlo de nuevo desde ahí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu visual não pôde ser criado a partir destas fotos. Nenhum visual gratuito foi usado — sua roupa está pronta de qualquer forma, e você pode tentar de novo a partir dela."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Look konnte aus diesen Fotos nicht erstellt werden. Es wurde kein kostenloser Look verwendet — dein Outfit ist so oder so bereit, und du kannst es von dort erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre look n'a pas pu être créé à partir de ces photos. Aucun look gratuit n'a été utilisé — votre tenue est prête dans tous les cas, et vous pouvez réessayer depuis là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile creare il tuo look da queste foto. Nessun look gratuito è stato usato — il tuo outfit è pronto comunque, e puoi riprovare da lì."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je look kon niet van deze foto's worden gemaakt. Er is geen gratis look gebruikt — je outfit is hoe dan ook klaar, en je kunt het van daaruit opnieuw proberen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの写真からルックを作成できませんでした。無料ルックは使用されていません — コーディネートはどちらにしても用意されており、そこから再試行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진들로는 룩을 만들 수 없었습니다. 무료 룩은 사용되지 않았습니다 — 아웃핏은 어떤 경우든 준비되어 있으며, 거기서 다시 시도할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法用这些照片生成你的造型。没有使用免费造型——无论如何你的穿搭都已准备好，你可以从那里重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法用這些照片製作你的造型。沒有使用任何免費造型——你的裝扮無論如何都已準備好，你可以從那裡重試。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر صنع إطلالتك من هذه الصور. لم تُستخدم أي إطلالة مجانية — إطلالتك جاهزة في كلتا الحالتين، ويمكنك المحاولة مجددًا من هناك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन फ़ोटो से आपका लुक नहीं बनाया जा सका। कोई मुफ़्त लुक इस्तेमाल नहीं हुआ — आपकी आउटफ़िट किसी भी तरह तैयार है, और आप वहाँ से फिर से कोशिश कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilanmu tidak dapat dibuat dari foto-foto ini. Tidak ada tampilan gratis yang digunakan — outfitmu tetap siap, dan kamu dapat mencoba lagi dari sana."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünümün bu fotoğraflardan oluşturulamadı. Hiçbir ücretsiz görünüm kullanılmadı — kombinin her durumda hazır ve oradan tekrar deneyebilirsin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się utworzyć Twojego wyglądu z tych zdjęć. Nie użyto żadnego darmowego wyglądu — Twój strój jest gotowy tak czy inaczej i możesz spróbować ponownie z niego."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш образ не удалось создать из этих фотографий. Бесплатный образ не был использован — ваш комплект в любом случае готов, и вы можете попробовать снова оттуда."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din look kunde inte skapas från de här fotona. Ingen gratislook användes — din outfit är redo hur som helst, och du kan försöka igen därifrån."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างลุคของคุณจากรูปเหล่านี้ไม่ได้ ไม่ได้ใช้ลุคฟรี — ชุดของคุณพร้อมไม่ว่าอย่างไร และคุณสามารถลองอีกครั้งจากที่นั่น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tạo diện mạo của bạn từ những ảnh này. Không có diện mạo miễn phí nào được dùng — trang phục của bạn sẵn sàng dù thế nào, và bạn có thể thử lại từ đó."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш образ не вдалося створити з цих фото. Жоден безкоштовний образ не використано — ваш образ готовий у будь-якому разі, і ви можете спробувати ще раз звідти."
          }
        }
      }
    },
