    "flow_consent_delete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can delete your photos and every picture made from them at any time: Settings → Make It Me → Delete my photos. Deleting is permanent and takes effect right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes eliminar tus fotos y todas las imágenes creadas a partir de ellas en cualquier momento: Ajustes → Make It Me → Eliminar mis fotos. La eliminación es permanente y tiene efecto inmediato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode excluir suas fotos e todas as imagens criadas a partir delas a qualquer momento: Configurações → Make It Me → Excluir minhas fotos. A exclusão é permanente e tem efeito imediato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst deine Fotos und jedes daraus erstellte Bild jederzeit löschen: Einstellungen → Make It Me → Meine Fotos löschen. Das Löschen ist endgültig und wirkt sofort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez supprimer vos photos et chaque image créée à partir d'elles à tout moment : Réglages → Make It Me → Supprimer mes photos. La suppression est définitive et prend effet immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi eliminare le tue foto e ogni immagine creata da esse in qualsiasi momento: Impostazioni → Make It Me → Elimina le mie foto. L'eliminazione è definitiva e ha effetto immediato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt je foto's en elke daarvan gemaakte foto op elk moment verwijderen: Instellingen → Make It Me → Verwijder mijn foto's. Verwijderen is permanent en gaat direct in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真と、それをもとに作成されたすべての画像はいつでも削除できます：設定 → Make It Me → 写真を削除。削除は永久的で、すぐに反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 그 사진으로 만든 모든 이미지는 언제든 삭제할 수 있습니다: 설정 → Make It Me → 내 사진 삭제. 삭제는 영구적이며 즉시 적용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以随时删除你的照片以及用它们生成的每一张图片：设置 → Make It Me → 删除我的照片。删除是永久性的，并立即生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你隨時可以刪除你的照片以及用它們製作的每一張圖片：設定 → Make It Me → 刪除我的照片。刪除是永久性的，並會立即生效。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك حذف صورك وكل صورة صُنعت منها في أي وقت: الإعدادات ← Make It Me ← حذف صوري. الحذف نهائي ويسري فورًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप कभी भी अपनी फ़ोटो और उनसे बनी हर तस्वीर हटा सकते हैं: Settings → Make It Me → Delete my photos. हटाना स्थायी है और तुरंत प्रभावी होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu dapat menghapus fotomu dan setiap gambar yang dibuat darinya kapan saja: Pengaturan → Make It Me → Hapus foto saya. Penghapusan bersifat permanen dan langsung berlaku."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflarını ve onlardan oluşturulan her resmi istediğin zaman silebilirsin: Ayarlar → Make It Me → Fotoğraflarımı sil. Silme işlemi kalıcıdır ve hemen yürürlüğe girer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz w każdej chwili usunąć swoje zdjęcia i każde utworzone z nich zdjęcie: Ustawienia → Make It Me → Usuń moje zdjęcia. Usunięcie jest trwałe i działa od razu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете в любой момент удалить свои фотографии и все созданные из них изображения: Настройки → Make It Me → Удалить мои фото. Удаление окончательное и вступает в силу сразу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan radera dina foton och varje bild som skapats från dem när som helst: Inställningar → Make It Me → Radera mina foton. Raderingen är permanent och gäller omedelbart."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถลบรูปภาพและรูปทุกใบที่สร้างจากรูปเหล่านั้นได้ทุกเมื่อ: การตั้งค่า → Make It Me → ลบรูปภาพของฉัน การลบเป็นการถาวรและมีผลทันที"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể xóa ảnh của mình và mọi ảnh được tạo từ chúng bất cứ lúc nào: Cài đặt → Make It Me → Xóa ảnh của tôi. Việc xóa là vĩnh viễn và có hiệu lực ngay lập tức."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете будь-коли видалити свої фото й усі створені з них зображення: Налаштування → Make It Me → Видалити мої фото. Видалення є остаточним і набуває чинності одразу."
          }
        }
      }
    },
    "flow_consent_kept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pictures made from your photos are kept only for you, so your outfits are ready when you open the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes creadas a partir de tus fotos se guardan solo para ti, para que tus conjuntos estén listos cuando abras la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens criadas a partir das suas fotos são guardadas só para você, para que suas roupas estejam prontas quando você abrir o app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder, die aus deinen Fotos erstellt werden, werden nur für dich aufbewahrt, damit deine Outfits bereit sind, wenn du die App öffnest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images créées à partir de vos photos sont conservées uniquement pour vous, afin que vos tenues soient prêtes quand vous ouvrez l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini create dalle tue foto sono conservate solo per te, così i tuoi outfit sono pronti quando apri l'app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto's die van je foto's worden gemaakt, worden alleen voor jou bewaard, zodat je outfits klaarstaan wanneer je de app opent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの写真から作成された画像はあなた専用に保管され、アプリを開いたときにコーディネートがすぐ見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진으로 만든 이미지는 사용자만을 위해 보관되므로, 앱을 열면 아웃핏이 준비되어 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你的照片生成的图片只为你保留，这样你打开应用时穿搭就已准备好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用你的照片製作的圖片只會為你保留，讓你打開 App 時裝扮已經準備好。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ الصور المصنوعة من صورك لك وحدك، لتكون إطلالاتك جاهزة عند فتح التطبيق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ोटो से बनी तस्वीरें सिर्फ़ आपके लिए रखी जाती हैं, ताकि ऐप खोलने पर आपकी आउटफ़िट तैयार मिलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar yang dibuat dari fotomu hanya disimpan untukmu, agar outfitmu siap saat kamu membuka aplikasi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflarından oluşturulan resimler yalnızca senin için saklanır, böylece uygulamayı açtığında kombinlerin hazır olur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia utworzone z Twoich zdjęć są przechowywane tylko dla Ciebie, aby Twoje stroje były gotowe, gdy otworzysz aplikację."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображения, созданные из ваших фотографий, хранятся только для вас, чтобы ваши комплекты были готовы, когда вы откроете приложение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder som skapats från dina foton sparas bara för dig, så att dina outfits är redo när du öppnar appen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปที่สร้างจากรูปภาพของคุณจะเก็บไว้สำหรับคุณเท่านั้น เพื่อให้ชุดของคุณพร้อมเมื่อคุณเปิดแอป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh được tạo từ ảnh của bạn chỉ được giữ cho bạn, để trang phục của bạn sẵn sàng khi bạn mở ứng dụng."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зображення, створені з ваших фото, зберігаються лише для вас, щоб ваші образи були готові, коли ви відкриєте застосунок."
          }
        }
      }
    },
    "flow_consent_never": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos are never used to train AI models. They're never shown to other users, never added to RunWear's standard photo library, and never shared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos nunca se usan para entrenar modelos de IA. Nunca se muestran a otros usuarios, nunca se añaden a la biblioteca de fotos estándar de RunWear y nunca se comparten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas fotos nunca são usadas para treinar modelos de IA. Nunca são mostradas a outros usuários, nunca adicionadas à biblioteca de fotos padrão do RunWear e nunca compartilhadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos werden nie zum Trainieren von KI-Modellen verwendet. Sie werden nie anderen Nutzern gezeigt, nie zur Standard-Fotobibliothek von RunWear hinzugefügt und nie geteilt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos photos ne servent jamais à entraîner des modèles d'IA. Elles ne sont jamais montrées à d'autres utilisateurs, jamais ajoutées à la bibliothèque de photos standard de RunWear, et jamais partagées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue foto non vengono mai usate per addestrare modelli di IA. Non vengono mai mostrate ad altri utenti, mai aggiunte alla libreria di foto standard di RunWear e mai condivise."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je foto's worden nooit gebruikt om AI-modellen te trainen. Ze worden nooit aan andere gebruikers getoond, nooit toegevoegd aan de standaardfotobibliotheek van RunWear en nooit gedeeld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの写真がAIモデルの学習に使われることは決してありません。他のユーザーに表示されることも、RunWearの標準写真ライブラリに追加されることも、共有されることもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 AI 모델 학습에 절대 사용되지 않습니다. 다른 사용자에게 절대 공개되지 않으며, RunWear의 기본 사진 라이브러리에 절대 추가되지 않고, 절대 공유되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的照片绝不会用于训练 AI 模型。它们绝不会展示给其他用户，绝不会加入 RunWear 的标准照片库，也绝不会被分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的照片絕不會用於訓練 AI 模型，絕不會展示給其他使用者，絕不會加入 RunWear 的標準照片庫，也絕不會分享出去。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُستخدم صورك أبدًا لتدريب نماذج الذكاء الاصطناعي. ولا تُعرض أبدًا على مستخدمين آخرين، ولا تُضاف أبدًا إلى مكتبة الصور القياسية في RunWear، ولا تُشارك أبدًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ोटो का इस्तेमाल कभी भी AI मॉडल को प्रशिक्षित करने के लिए नहीं किया जाता। वे कभी दूसरे उपयोगकर्ताओं को नहीं दिखाई जातीं, कभी RunWear की मानक फ़ोटो लाइब्रेरी में नहीं जोड़ी जातीं, और कभी साझा नहीं की जातीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotomu tidak pernah digunakan untuk melatih model AI. Foto itu tidak pernah ditampilkan ke pengguna lain, tidak pernah ditambahkan ke pustaka foto standar RunWear, dan tidak pernah dibagikan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafların asla yapay zekâ modellerini eğitmek için kullanılmaz. Asla diğer kullanıcılara gösterilmez, asla RunWear'ın standart fotoğraf kitaplığına eklenmez ve asla paylaşılmaz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje zdjęcia nigdy nie służą do trenowania modeli AI. Nigdy nie są pokazywane innym użytkownikom, nigdy nie trafiają do standardowej biblioteki zdjęć RunWear i nigdy nie są udostępniane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши фотографии никогда не используются для обучения моделей ИИ. Их никогда не показывают другим пользователям, никогда не добавляют в стандартную библиотеку фото RunWear и никому не передают."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina foton används aldrig för att träna AI-modeller. De visas aldrig för andra användare, läggs aldrig till i RunWears standardfotobibliotek och delas aldrig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพของคุณจะไม่ถูกใช้ฝึกโมเดล AI จะไม่แสดงให้ผู้ใช้คนอื่นเห็น ไม่เพิ่มลงในคลังรูปภาพมาตรฐานของ RunWear และไม่แชร์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh của bạn không bao giờ được dùng để huấn luyện mô hình AI. Chúng không bao giờ được hiển thị cho người dùng khác, không bao giờ được thêm vào thư viện ảnh tiêu chuẩn của RunWear, và không bao giờ được chia sẻ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші фото ніколи не використовуються для навчання моделей ШІ. Їх ніколи не показують іншим користувачам, ніколи не додають до стандартної бібліотеки фото RunWear і ніколи не передають іншим."
          }
        }
      }
    },
    "flow_consent_nothing_else": {
