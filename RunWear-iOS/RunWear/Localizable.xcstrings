    "onb_setup_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three quick calls. You can change any of them later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres decisiones rápidas. Puedes cambiar cualquiera de ellas después en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Três escolhas rápidas. Você pode alterar qualquer uma depois em Configurações."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei schnelle Entscheidungen. Du kannst jede später in den Einstellungen ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois choix rapides. Vous pouvez les changer plus tard dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre scelte rapide. Puoi cambiarle in seguito nelle Impostazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drie snelle keuzes. Je kunt ze later allemaal wijzigen in Instellingen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "簡単な選択が3つ。あとから設定で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세 가지 빠른 선택. 나중에 설정에서 언제든 변경할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三个快速选择。你以后可以在“设置”中更改任何一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三個快速選擇。你之後隨時可以在「設定」中更改任何一項。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثلاثة اختيارات سريعة. يمكنك تغيير أي منها لاحقًا في الإعدادات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीन त्वरित चुनाव। आप बाद में Settings में इनमें से कोई भी बदल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiga pilihan cepat. Kamu dapat mengubahnya kapan pun nanti di Pengaturan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç hızlı seçim. Bunların herhangi birini daha sonra Ayarlar'dan değiştirebilirsin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzy szybkie decyzje. Każdą możesz później zmienić w Ustawieniach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три быстрых выбора. Любой из них можно изменить позже в настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre snabba val. Du kan ändra vilket som helst av dem senare i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามคำถามสั้น ๆ คุณสามารถเปลี่ยนได้ทุกเมื่อในภายหลังในการตั้งค่า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba lựa chọn nhanh. Bạn có thể thay đổi bất kỳ lựa chọn nào sau trong Cài đặt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Три швидкі вибори. Будь-який з них можна змінити пізніше в Налаштуваннях."
          }
        }
      }
    },
