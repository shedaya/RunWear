    "view_rating_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick rating helps other runners find their outfit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una valoración rápida ayuda a otros corredores a encontrar su conjunto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma avaliação rápida ajuda outros corredores a encontrar sua roupa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine schnelle Bewertung hilft anderen Läufern, ihr Outfit zu finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une note rapide aide d'autres coureurs à trouver leur tenue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una valutazione rapida aiuta altri runner a trovare il loro outfit."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een snelle beoordeling helpt andere hardlopers hun outfit te vinden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "簡単な評価が、他のランナーがコーディネートを見つける助けになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 평가가 다른 러너들이 아웃핏을 찾는 데 도움이 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个快速评分能帮助其他跑者找到他们的穿搭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簡短的評分能幫助其他跑者找到他們的裝扮。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقييم سريع يساعد العدّائين الآخرين على العثور على إطلالتهم."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक त्वरित रेटिंग अन्य धावकों को उनकी आउटफ़िट खोजने में मदद करती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penilaian singkat membantu pelari lain menemukan outfit mereka."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı bir puan, diğer koşucuların kombinlerini bulmasına yardımcı olur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybka ocena pomaga innym biegaczom znaleźć swój strój."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрая оценка помогает другим бегунам найти свой комплект."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett snabbt betyg hjälper andra löpare att hitta sin outfit."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การให้คะแนนสั้น ๆ ช่วยให้นักวิ่งคนอื่นหาชุดของพวกเขา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh giá nhanh giúp những người chạy khác tìm thấy trang phục của họ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Швидка оцінка допомагає іншим бігунам знайти свій образ."
          }
        }
      }
    },
