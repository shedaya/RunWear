    "vm_location_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location isn't available. Your places, settings, and photos stay on this phone — nothing is lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación no está disponible. Tus lugares, ajustes y fotos permanecen en este teléfono: no se pierde nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização não está disponível. Seus lugares, configurações e fotos permanecem neste celular — nada foi perdido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort ist nicht verfügbar. Deine Orte, Einstellungen und Fotos bleiben auf diesem Telefon — nichts geht verloren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation n'est pas disponible. Vos lieux, réglages et photos restent sur ce téléphone — rien n'est perdu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione non è disponibile. I tuoi luoghi, le impostazioni e le foto restano su questo telefono — niente è perduto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatie is niet beschikbaar. Je plaatsen, instellingen en foto's blijven op deze telefoon — er gaat niets verloren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報が利用できません。あなたの場所、設定、写真はこのスマートフォンに残ります — 何も失われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 사용할 수 없습니다. 장소, 설정, 사진은 이 휴대폰에 그대로 남아 있습니다 — 잃어버리는 것은 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置不可用。你的地点、设置和照片都留在这部手机上——什么都不会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置無法使用。你的地點、設定和照片都保留在這支手機上——沒有遺失任何東西。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموقع غير متاح. أماكنك وإعداداتك وصورك تبقى على هذا الهاتف — لا شيء يضيع."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान उपलब्ध नहीं है। आपकी जगहें, सेटिंग और फ़ोटो इस फ़ोन पर रहती हैं — कुछ भी खोता नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi tidak tersedia. Tempat, pengaturan, dan fotomu tetap di ponsel ini — tidak ada yang hilang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum kullanılamıyor. Yerlerin, ayarların ve fotoğrafların bu telefonda kalır — hiçbir şey kaybolmaz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalizacja nie jest dostępna. Twoje miejsca, ustawienia i zdjęcia pozostają na tym telefonie — nic nie jest stracone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Геолокация недоступна. Ваши места, настройки и фотографии остаются на этом телефоне — ничего не потеряно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Plats är inte tillgänglig. Dina platser, inställningar och foton stannar på den här telefonen — ingenting går förlorat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตำแหน่งไม่พร้อม สถานที่ การตั้งค่า และรูปภาพของคุณอยู่บนโทรศัพท์เครื่องนี้ — ไม่มีอะไรหาย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí không khả dụng. Các địa điểm, cài đặt và ảnh của bạn ở lại trên điện thoại này — không có gì bị mất."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місцезнаходження недоступне. Ваші місця, налаштування й фото залишаються на цьому телефоні — нічого не втрачено."
          }
        }
      }
    },
    "vm_weather_unreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The weather service couldn't be reached. Your places, settings, and photos stay on this phone — nothing is lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con el servicio meteorológico. Tus lugares, ajustes y fotos permanecen en este teléfono: no se pierde nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível conectar ao serviço de clima. Seus lugares, configurações e fotos permanecem neste celular — nada foi perdido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wetterdienst konnte nicht erreicht werden. Deine Orte, Einstellungen und Fotos bleiben auf diesem Telefon — nichts geht verloren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service météo n'a pas pu être joint. Vos lieux, réglages et photos restent sur ce téléphone — rien n'est perdu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile contattare il servizio meteo. I tuoi luoghi, le impostazioni e le foto restano su questo telefono — niente è perduto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De weerservice kon niet worden bereikt. Je plaatsen, instellingen en foto's blijven op deze telefoon — er gaat niets verloren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気サービスに接続できませんでした。あなたの場所、設定、写真はこのスマートフォンに残ります — 何も失われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날씨 서비스에 연결할 수 없었습니다. 장소, 설정, 사진은 이 휴대폰에 그대로 남아 있습니다 — 잃어버리는 것은 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接天气服务。你的地点、设置和照片都留在这部手机上——什么都不会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線到天氣服務。你的地點、設定和照片都保留在這支手機上——沒有遺失任何東西。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى خدمة الطقس. أماكنك وإعداداتك وصورك تبقى على هذا الهاتف — لا شيء يضيع."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौसम सेवा तक नहीं पहुँचा जा सका। आपकी जगहें, सेटिंग और फ़ोटो इस फ़ोन पर रहती हैं — कुछ भी खोता नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan cuaca tidak dapat dihubungi. Tempat, pengaturan, dan fotomu tetap di ponsel ini — tidak ada yang hilang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava durumu servisine ulaşılamadı. Yerlerin, ayarların ve fotoğrafların bu telefonda kalır — hiçbir şey kaybolmaz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć z usługą pogodową. Twoje miejsca, ustawienia i zdjęcia pozostają na tym telefonie — nic nie jest stracone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться со службой погоды. Ваши места, настройки и фотографии остаются на этом телефоне — ничего не потеряно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vädertjänsten kunde inte nås. Dina platser, inställningar och foton stannar på den här telefonen — ingenting går förlorat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อบริการสภาพอากาศไม่ได้ สถานที่ การตั้งค่า และรูปภาพของคุณอยู่บนโทรศัพท์เครื่องนี้ — ไม่มีอะไรหาย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối dịch vụ thời tiết. Các địa điểm, cài đặt và ảnh của bạn ở lại trên điện thoại này — không có gì bị mất."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зв'язатися зі службою погоди. Ваші місця, налаштування й фото залишаються на цьому телефоні — нічого не втрачено."
          }
        }
      }
    },
