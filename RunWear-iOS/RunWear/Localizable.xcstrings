    "mim_reject_face_too_small": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your face is small in that photo — A closer selfie works best — a mirror selfie is great too. Or let the camera guide you…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu rostro se ve pequeño en esa foto: un selfi más de cerca funciona mejor, y un selfi en el espejo también es ideal. O deja que la cámara te guíe…"
          }
        }
      }
    },
    "mim_reject_face_unclear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can't see your face clearly in this one. Try a photo without sunglasses or a hat shadow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se distingue bien tu rostro en esta foto. Prueba con una sin gafas de sol ni sombra de gorra."
          }
        }
      }
    },
    "mim_reject_multiple_people": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo has more than one person in it. Pick one that's just you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta foto hay más de una persona. Elige una en la que estés solo tú."
          }
        }
      }
    },
    "mim_reject_rotated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo came out sideways. Retake it holding your phone upright, or pick a photo that's already upright."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto salió de lado. Hazla de nuevo con el teléfono en vertical, o elige una foto que ya esté en vertical."
          }
        }
      }
    },
    "mim_reject_too_close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the phone at arm's length, so your whole face fits with space around it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sujeta el teléfono con el brazo extendido, para que tu rostro entero quepa con espacio alrededor."
          }
        }
      }
    },
    "mim_reject_too_dark": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try facing a window or light, looking at the camera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba a ponerte frente a una ventana o una luz, mirando a la cámara."
          }
        }
      }
    },
    "mim_retake_face_too_small": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your face is small in that photo — A closer selfie works best — a mirror selfie is great too. Or let the camera guide you…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu rostro se ve pequeño en esa foto: un selfi más de cerca funciona mejor, y un selfi en el espejo también es ideal. O deja que la cámara te guíe…"
          }
        }
      }
    },
