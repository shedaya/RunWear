    "flow_either_way": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Either way, your recommendations don't change — only the photo does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cualquier caso, tus recomendaciones no cambian: solo cambia la foto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De qualquer forma, suas recomendações não mudam — só a foto muda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So oder so ändern sich deine Empfehlungen nicht — nur das Foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les deux cas, vos recommandations ne changent pas — seule la photo change."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ogni caso, i tuoi consigli non cambiano — cambia solo la foto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe dan ook veranderen je aanbevelingen niet — alleen de foto verandert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらを選んでもおすすめは変わりません。変わるのは写真だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 경우든 추천은 바뀌지 않습니다 — 사진만 바뀝니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论哪种方式，你的推荐都不会改变——变的只有照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論哪一種，你的推薦都不會改變——只有照片不同。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في كلتا الحالتين، لا تتغير توصياتك — تتغير الصورة فقط."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी तरह, आपकी सिफ़ारिशें नहीं बदलतीं — सिर्फ़ फ़ोटो बदलती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa pun pilihannya, rekomendasimu tidak berubah — hanya fotonya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her iki durumda da önerilerin değişmez — değişen yalnızca fotoğraftır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak czy inaczej Twoje rekomendacje się nie zmieniają — zmienia się tylko zdjęcie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В любом случае ваши рекомендации не меняются — меняется только фото."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur som helst ändras inte dina rekommendationer — bara fotot."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ว่าอย่างไร คำแนะนำของคุณจะไม่เปลี่ยน — เปลี่ยนเฉพาะรูปภาพเท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dù chọn cách nào, gợi ý của bạn không thay đổi — chỉ ảnh thay đổi."
          }
        },
        "uk": {
