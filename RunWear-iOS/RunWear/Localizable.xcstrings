    "settings_crash_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the app crashes, it can send us the technical details so we can fix it. This happens only after a crash, and only with your permission here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la app se cierra inesperadamente, puede enviarnos los detalles técnicos para que podamos corregirlo. Esto ocurre solo después de un cierre, y solo con tu permiso aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o app travar, ele pode nos enviar os detalhes técnicos para que possamos corrigir. Isso acontece apenas após um travamento, e apenas com sua permissão aqui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die App abstürzt, kann sie uns die technischen Details senden, damit wir es beheben können. Das passiert nur nach einem Absturz und nur mit deiner Erlaubnis hier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l'app plante, elle peut nous envoyer les détails techniques pour que nous puissions la corriger. Cela ne se produit qu'après un plantage, et uniquement avec votre autorisation ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se l'app si blocca, può inviarci i dettagli tecnici così possiamo correggerla. Questo avviene solo dopo un blocco e solo con il tuo permesso qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als de app crasht, kan hij ons de technische details sturen zodat we het kunnen oplossen. Dit gebeurt alleen na een crash, en alleen met je toestemming hier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがクラッシュした場合、修正のために技術的な詳細を送信できます。これはクラッシュ後にのみ、ここで許可した場合にのみ行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 충돌하면, 수정할 수 있도록 기술 세부 정보를 보낼 수 있습니다. 이는 충돌 후에만, 그리고 여기서 허용한 경우에만 발생합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果应用崩溃，它可以把技术细节发送给我们，以便我们修复。这只在崩溃后发生，并且只在你在此处允许的情况下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 App 當機，它可以把技術細節傳送給我們，讓我們修復。這只會在當機後發生，而且只在你於此處允許的情況下。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا تعطّل التطبيق، يمكنه إرسال التفاصيل التقنية إلينا لنصلحه. يحدث هذا فقط بعد عطل، وفقط بإذنك هنا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर ऐप क्रैश हो जाए, तो यह हमें तकनीकी विवरण भेज सकता है ताकि हम इसे ठीक कर सकें। यह केवल क्रैश के बाद होता है, और केवल यहाँ आपकी अनुमति से।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika aplikasi crash, ia dapat mengirimkan detail teknis kepada kami agar kami dapat memperbaikinya. Ini hanya terjadi setelah crash, dan hanya dengan izinmu di sini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama çökerse, düzeltmemiz için bize teknik ayrıntıları gönderebilir. Bu yalnızca bir çökmeden sonra ve yalnızca buradaki izninle olur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli aplikacja ulegnie awarii, może wysłać nam szczegóły techniczne, abyśmy mogli to naprawić. Dzieje się to tylko po awarii i tylko za Twoją zgodą tutaj."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если приложение вылетит, оно может отправить нам технические подробности, чтобы мы могли это исправить. Это происходит только после сбоя и только с вашего разрешения здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om appen kraschar kan den skicka oss de tekniska detaljerna så att vi kan fixa det. Detta sker bara efter en krasch, och bara med din tillåtelse här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากแอปล่ม มันสามารถส่งรายละเอียดทางเทคนิคมาให้เราเพื่อแก้ไข สิ่งนี้เกิดขึ้นหลังแอปล่มเท่านั้น และด้วยสิทธิ์ของคุณที่นี่เท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu ứng dụng gặp sự cố, nó có thể gửi cho chúng tôi chi tiết kỹ thuật để chúng tôi sửa. Việc này chỉ xảy ra sau sự cố, và chỉ với sự cho phép của bạn ở đây."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо застосунок аварійно завершить роботу, він може надіслати нам технічні деталі, щоб ми могли це виправити. Це відбувається лише після аварії й лише з вашого дозволу тут."
          }
        }
      }
    },
