    "onb_promise_3_phrase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn each day's outfit into a card you can share — a scrapbook of what you wore and where you ran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte el conjunto de cada día en una tarjeta que puedes compartir: un álbum de lo que llevaste y dónde corriste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme a roupa de cada dia em um cartão para compartilhar — um álbum do que você usou e onde correu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwandle das Outfit jedes Tages in eine Karte, die du teilen kannst — ein Sammelalbum von dem, was du getragen hast und wo du gelaufen bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez la tenue de chaque jour en une carte à partager — un album de ce que vous portiez et où vous avez couru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma l'outfit di ogni giorno in una scheda da condividere — un album di cosa hai indossato e dove hai corso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak van de outfit van elke dag een kaart om te delen — een plakboek van wat je droeg en waar je liep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その日のコーディネートを共有できるカードに — 何を着て、どこを走ったかのスクラップブックです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일의 아웃핏을 공유할 수 있는 카드로 만들어 보세요 — 무엇을 입고 어디서 달렸는지를 담은 스크랩북입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把每天的穿搭变成一张可以分享的卡片——一本记录你穿了什么、在哪里跑步的剪贴簿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把每天的裝扮變成一張可以分享的卡片——一本記錄你穿了什麼、跑去哪裡的剪貼簿。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حوّل إطلالة كل يوم إلى بطاقة يمكنك مشاركتها — سجلّ قصاصات لما ارتديته وأين جريت."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दिन की आउटफ़िट को साझा करने योग्य कार्ड में बदलें — आपने क्या पहना और कहाँ दौड़े, इसकी एक स्क्रैपबुक।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah outfit setiap hari menjadi kartu yang dapat kamu bagikan — scrapbook tentang apa yang kamu kenakan dan di mana kamu berlari."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her günün kombinini paylaşabileceğin bir karta dönüştür — ne giydiğinin ve nerede koştuğunun bir albümü."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamień strój każdego dnia w kartę, którą możesz udostępnić — album tego, co miałeś na sobie i gdzie biegałeś."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Превращайте комплект каждого дня в карточку, которой можно поделиться, — альбом того, что вы носили и где бегали."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förvandla varje dags outfit till ett kort du kan dela — en klippbok över vad du hade på dig och var du sprang."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนชุดของแต่ละวันให้เป็นการ์ดที่แชร์ได้ — สมุดภาพของสิ่งที่คุณสวมและที่ที่คุณวิ่ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biến trang phục mỗi ngày thành một thẻ bạn có thể chia sẻ — một cuốn lưu niệm về những gì bạn đã mặc và nơi bạn đã chạy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетворюйте образ кожного дня на картку, якою можна поділитися — альбом того, що ви носили й де бігали."
          }
        }
      }
    },
