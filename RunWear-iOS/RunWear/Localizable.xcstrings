    "support_location_denied_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear needs location access to show weather-based outfit recommendations. Please enable location access in Settings, or set your location manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear necesita acceso a la ubicación para mostrar recomendaciones de conjuntos según el tiempo. Activa el acceso a la ubicación en Ajustes, o define tu ubicación manualmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O RunWear precisa de acesso à localização para mostrar recomendações de roupas baseadas no clima. Ative o acesso à localização em Configurações ou defina sua localização manualmente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear braucht Standortzugriff, um wetterbasierte Outfit-Empfehlungen zu zeigen. Bitte aktiviere den Standortzugriff in den Einstellungen oder lege deinen Standort manuell fest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear a besoin de l'accès à la localisation pour afficher des recommandations de tenue basées sur la météo. Veuillez activer l'accès à la localisation dans Réglages, ou définir votre lieu manuellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear ha bisogno dell'accesso alla posizione per mostrare consigli di outfit basati sul meteo. Attiva l'accesso alla posizione nelle Impostazioni, oppure imposta la posizione manualmente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear heeft locatietoegang nodig om outfitadviezen op basis van het weer te tonen. Schakel locatietoegang in via Instellingen, of stel je locatie handmatig in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWearは、天気に基づくコーディネートのおすすめを表示するために位置情報へのアクセスが必要です。設定で位置情報へのアクセスを有効にするか、手動で場所を設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear는 날씨 기반 아웃핏 추천을 표시하려면 위치 접근이 필요합니다. 설정에서 위치 접근을 활성화하거나, 위치를 수동으로 설정해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear 需要位置访问来显示基于天气的穿搭推荐。请在“设置”中启用位置访问，或者手动设置你的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear 需要位置存取權，才能顯示依天氣推薦的裝扮。請在「設定」中啟用位置存取，或手動設定你的位置。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج RunWear إلى الوصول إلى الموقع لعرض توصيات إطلالات مبنية على الطقس. فعّل الوصول إلى الموقع في الإعدادات، أو حدّد موقعك يدويًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौसम-आधारित आउटफ़िट सिफ़ारिशें दिखाने के लिए RunWear को स्थान एक्सेस की ज़रूरत है। कृपया Settings में स्थान एक्सेस सक्षम करें, या अपना स्थान मैन्युअल रूप से सेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear membutuhkan akses lokasi untuk menampilkan rekomendasi outfit berdasarkan cuaca. Silakan aktifkan akses lokasi di Pengaturan, atau atur lokasimu secara manual."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear, hava durumuna dayalı kombin önerileri göstermek için konum erişimine ihtiyaç duyar. Lütfen Ayarlar'dan konum erişimini etkinleştir veya konumunu elle belirle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear potrzebuje dostępu do lokalizacji, aby pokazywać rekomendacje strojów oparte na pogodzie. Włącz dostęp do lokalizacji w Ustawieniach albo ustaw lokalizację ręcznie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear нужен доступ к геолокации, чтобы показывать рекомендации комплектов на основе погоды. Пожалуйста, включите доступ к геолокации в настройках или укажите ваше место вручную."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear behöver platsåtkomst för att visa väderbaserade outfitrekommendationer. Aktivera platsåtkomst i Inställningar, eller ange din plats manuellt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear ต้องการการเข้าถึงตำแหน่งเพื่อแสดงคำแนะนำชุดตามสภาพอากาศ โปรดเปิดการเข้าถึงตำแหน่งในการตั้งค่า หรือตั้งค่าตำแหน่งด้วยตนเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear cần quyền truy cập vị trí để hiển thị gợi ý trang phục dựa trên thời tiết. Vui lòng bật quyền truy cập vị trí trong Cài đặt, hoặc đặt vị trí của bạn thủ công."
          }
        },
        "uk": {
