          "stringUnit": {
            "state": "translated",
            "value": "RunWear necesita acceso a la ubicación para mostrar recomendaciones de conjuntos según el tiempo. Activa el acceso a la ubicación en Ajustes, o define tu ubicación manualmente."
          }
        }
