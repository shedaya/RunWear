        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توصياتك، وأنت في الصورة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी सिफ़ारिशें, फ़ोटो में आप के साथ।"
          }
        },
        "id": {
          "stringUnit": {
