        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comfortable humidity for running. Stay hydrated as usual."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Humedad cómoda para correr. Hidrátate como siempre."
          }
        }
      }
    },
    "tip_humidity_high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High humidity makes it harder to cool down. Slow your pace and hydrate frequently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La humedad alta hace más difícil refrescarse. Baja tu ritmo e hidrátate con frecuencia."
          }
        }
      }
    },
    "tip_humidity_low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low humidity can be deceptively dehydrating. Drink before you feel thirsty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La humedad baja puede deshidratar sin que te des cuenta. Bebe antes de tener sed."
          }
        }
      }
    },
    "tip_rain_gear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consider waterproof gear and protect electronics in a ziplock bag."
