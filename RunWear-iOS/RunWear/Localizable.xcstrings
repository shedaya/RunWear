            "value": "Ещё одно — где вы бегаете?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En sak till — var springer du?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีกเรื่องเดียว — คุณวิ่งที่ไหน?"
