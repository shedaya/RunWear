    "support_location_needed_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear needs your location to provide accurate weather-based outfit recommendations for your area."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear necesita tu ubicación para ofrecer recomendaciones precisas de conjuntos según el tiempo de tu zona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O RunWear precisa da sua localização para fornecer recomendações precisas de roupas baseadas no clima para sua área."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear braucht deinen Standort, um genaue wetterbasierte Outfit-Empfehlungen für deine Gegend zu liefern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear a besoin de votre localisation pour fournir des recommandations de tenue précises basées sur la météo pour votre zone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear ha bisogno della tua posizione per fornire consigli di outfit precisi, basati sul meteo, per la tua zona."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear heeft je locatie nodig om nauwkeurige outfitadviezen op basis van het weer voor jouw gebied te geven."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWearは、お住まいの地域の正確な天気に基づくコーディネートのおすすめを提供するために位置情報が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear는 지역에 맞는 정확한 날씨 기반 아웃핏 추천을 제공하기 위해 위치가 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear 需要你的位置，才能为你所在区域提供准确的基于天气的穿搭推荐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear 需要你的位置，才能為你的地區提供準確的依天氣裝扮推薦。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج RunWear إلى موقعك لتقديم توصيات إطلالات دقيقة مبنية على الطقس لمنطقتك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके क्षेत्र के लिए सटीक मौसम-आधारित आउटफ़िट सिफ़ारिशें देने के लिए RunWear को आपके स्थान की ज़रूरत है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear membutuhkan lokasimu untuk memberikan rekomendasi outfit berdasarkan cuaca yang akurat untuk areamu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear, bölgen için doğru hava durumuna dayalı kombin önerileri sunmak için konumuna ihtiyaç duyar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear potrzebuje Twojej lokalizacji, aby zapewnić dokładne rekomendacje strojów oparte na pogodzie dla Twojej okolicy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear нужна ваша геолокация, чтобы предоставлять точные рекомендации комплектов на основе погоды для вашего района."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear behöver din plats för att ge exakta väderbaserade outfitrekommendationer för ditt område."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear ต้องการตำแหน่งของคุณเพื่อให้คำแนะนำชุดตามสภาพอากาศที่แม่นยำสำหรับพื้นที่ของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear cần vị trí của bạn để cung cấp gợi ý trang phục dựa trên thời tiết chính xác cho khu vực của bạn."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear потрібне ваше місцезнаходження, щоб надавати точні рекомендації образів на основі погоди для вашої області."
          }
        }
      }
    },
