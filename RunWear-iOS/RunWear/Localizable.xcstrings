          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lieux que vous choisissez seront conservés ici"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I luoghi che scegli saranno conservati qui"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaatsen die je kiest, worden hier bewaard"
          }
        },
        "ja": {
