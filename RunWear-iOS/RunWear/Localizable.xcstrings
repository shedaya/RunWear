    "flow_photo_guidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One front-facing photo of your face works best: good light, no sunglasses. The generator reads only your face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo mejor es una foto frontal de tu rostro: buena luz, sin gafas de sol. El generador solo lee tu rostro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma foto do seu rosto de frente funciona melhor: boa luz, sem óculos de sol. O gerador lê apenas seu rosto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein frontales Foto deines Gesichts funktioniert am besten: gutes Licht, keine Sonnenbrille. Der Generator liest nur dein Gesicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une photo de face de votre visage fonctionne mieux : bonne lumière, pas de lunettes de soleil. Le générateur ne lit que votre visage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una foto frontale del tuo viso funziona meglio: buona luce, niente occhiali da sole. Il generatore legge solo il tuo viso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén foto van je gezicht van voren werkt het best: goed licht, geen zonnebril. De generator leest alleen je gezicht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正面を向いた顔写真1枚が最適です：明るい場所で、サングラスなしで。ジェネレーターは顔だけを読み取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정면을 향한 얼굴 사진 한 장이 가장 좋습니다: 밝은 곳에서, 선글라스 없이. 생성기는 얼굴만 읽습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一张正脸照片效果最好：光线充足，不要戴太阳镜。生成器只读取你的脸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一張臉部朝正面的照片效果最好：光線充足、不要戴太陽眼鏡。生成器只讀取你的臉。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صورة أمامية واحدة لوجهك هي الأفضل: إضاءة جيدة، دون نظارات شمسية. يقرأ المولّد وجهك فقط."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके चेहरे की सामने से ली गई एक फ़ोटो सबसे अच्छी रहती है: अच्छी रोशनी, धूप का चश्मा नहीं। जनरेटर केवल आपका चेहरा पढ़ता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu foto wajahmu dari depan paling baik: cahaya cukup, tanpa kacamata hitam. Generator hanya membaca wajahmu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzünün önden tek bir fotoğrafı en iyisi olur: iyi ışık, güneş gözlüğü yok. Üretici yalnızca yüzünü okur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno zdjęcie twarzy z przodu sprawdza się najlepiej: dobre światło, bez okularów przeciwsłonecznych. Generator odczytuje tylko Twoją twarz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучше всего работает одно фото вашего лица анфас: хорошее освещение, без солнцезащитных очков. Генератор считывает только ваше лицо."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett foto av ditt ansikte framifrån fungerar bäst: bra ljus, inga solglasögon. Generatorn läser bara ditt ansikte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปใบหน้าแบบหันหน้าตรงหนึ่งรูปดีที่สุด: แสงดี ไม่มีแว่นกันแดด ตัวสร้างอ่านเฉพาะใบหน้าของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một ảnh khuôn mặt hướng thẳng là tốt nhất: ánh sáng tốt, không đeo kính râm. Trình tạo chỉ đọc khuôn mặt bạn."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найкраще підійде одне фото вашого обличчя анфас: добре освітлення, без сонцезахисних окулярів. Генератор зчитує лише ваше обличчя."
          }
        }
      }
    },
    "flow_recommendations_you": {
