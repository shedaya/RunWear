    "onb_body_sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you get cold easily, or overheat quickly?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Pasas frío con facilidad, o te acaloras rápido?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você sente frio com facilidade ou superaquece rápido?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird dir leicht kalt, oder überhitzt du schnell?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avez-vous facilement froid, ou surchauffez-vous vite ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senti freddo facilmente o ti surriscaldi in fretta?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krijg je het snel koud, of raak je snel oververhit?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "寒がりですか、それとも暑くなりやすいですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추위를 쉽게 타나요, 아니면 금방 더워지나요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你容易觉得冷，还是容易过热？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你容易覺得冷，還是容易過熱？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تشعر بالبرد بسهولة، أم ترتفع حرارتك بسرعة؟"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आपको आसानी से ठंड लगती है, या जल्दी ज़्यादा गर्मी लगती है?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah kamu mudah kedinginan, atau cepat kepanasan?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolay üşür müsün, yoksa çabuk aşırı ısınır mısın?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy łatwo marzniesz, czy szybko się przegrzewasz?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы легко мёрзнете или быстро перегреваетесь?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fryser du lätt, eller blir du snabbt överhettad?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณหนาวง่าย หรือร้อนเร็ว?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn dễ bị lạnh, hay nhanh quá nóng?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви легко мерзнете чи швидко перегріваєтеся?"
          }
        }
      }
    },
