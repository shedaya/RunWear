    "settings_delete_data": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete my data"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar mis datos"
          }
        }
      }
    },
    "settings_delete_data_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything RunWear holds for you will be deleted from our server and this phone: your photos, every picture made from them, and your account itself. This can't be undone. Deleting your data does not cancel a subscription — you can manage that from your store account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que RunWear guarda de ti se eliminará de nuestro servidor y de este teléfono: tus fotos, todas las imágenes creadas a partir de ellas y tu cuenta. Esto no se puede deshacer. Eliminar tus datos no cancela una suscripción: puedes gestionarla desde tu cuenta de la tienda."
          }
        }
      }
    },
    "settings_delete_data_done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data and account are deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos y tu cuenta están eliminados."
          }
        }
      }
    },
    "settings_delete_data_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data could not be deleted. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos no se pudieron eliminar. Inténtalo de nuevo."
          }
        }
      }
    },
    "settings_delete_data_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all your data?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar todos tus datos?"
          }
        }
      }
    },
    "settings_delete_photos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete my photos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar mis fotos"
          }
        }
      }
    },
    "settings_delete_photos_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos and every picture made from them will be deleted from our server and this phone. Your outfit pictures go back to the standard photos, and Make It Me turns off. This can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos y todas las imágenes creadas a partir de ellas se eliminarán de nuestro servidor y de este teléfono. Las imágenes de tus conjuntos volverán a las fotos estándar, y Make It Me se desactivará. Esto no se puede deshacer."
          }
        }
      }
    },
    "settings_delete_photos_done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos and pictures are deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos e imágenes están eliminadas."
          }
        }
      }
    },
    "settings_delete_photos_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos could not be deleted. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
