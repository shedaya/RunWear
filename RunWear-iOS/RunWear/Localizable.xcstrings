    "collection_empty_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each day's outfit is saved here automatically — one card per day, in the places you've run. Nothing is backfilled. It begins the first time today's outfit is generated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El conjunto de cada día se guarda aquí automáticamente: una tarjeta por día, en los lugares donde has corrido. No se rellena nada hacia atrás. Empieza la primera vez que se genera el conjunto de hoy."
          }
        }
      }
    },
