    "mim_band_line": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We're generating your outfits across all running conditions, so it will be ready when you need it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos generando tus conjuntos para todas las condiciones de carrera, para que estén listos cuando los necesites."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos gerando suas roupas para todas as condições de corrida, para que estejam prontas quando você precisar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir generieren deine Outfits für alle Laufbedingungen, damit es bereit ist, wenn du es brauchst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous générons vos tenues pour toutes les conditions de course, afin qu'elles soient prêtes quand vous en aurez besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiamo generando i tuoi outfit per tutte le condizioni di corsa, così saranno pronti quando ti serviranno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We genereren je outfits voor alle hardloopomstandigheden, zodat ze klaar zijn wanneer je ze nodig hebt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あらゆるランニング条件に合わせてコーディネートを生成しています。必要なときにすぐ使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 러닝 조건에 맞는 아웃핏을 생성하고 있으니, 필요할 때 준비되어 있을 것입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们正在为所有跑步条件生成你的穿搭，这样你需要时它就已准备好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們正在針對所有跑步條件生成你的裝扮，讓你在需要時隨時可用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نولّد إطلالاتك عبر جميع ظروف الجري، لتكون جاهزة عند حاجتك إليها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम दौड़ की सभी स्थितियों के लिए आपकी आउटफ़िट बना रहे हैं, ताकि ज़रूरत पड़ने पर वे तैयार मिलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami membuat outfitmu untuk semua kondisi lari, agar siap saat kamu membutuhkannya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombinlerini tüm koşu koşullarında oluşturuyoruz, böylece ihtiyacın olduğunda hazır olur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Generujemy Twoje stroje na wszystkie warunki biegowe, aby były gotowe, gdy ich potrzebujesz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы генерируем ваши комплекты для всех беговых условий, чтобы они были готовы, когда понадобятся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi genererar dina outfits för alla löpförhållanden, så att de är redo när du behöver dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรากำลังสร้างชุดของคุณสำหรับทุกสภาพการวิ่ง เพื่อให้พร้อมเมื่อคุณต้องการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đang tạo trang phục của bạn cho mọi điều kiện chạy, để chúng sẵn sàng khi bạn cần."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми створюємо ваші образи для всіх умов бігу, щоб вони були готові, коли знадобляться."
          }
        }
      }
    },
    "mim_band_ready_line": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready the moment you open the app — made ahead, never while you wait."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listos en el momento en que abres la app: creados por adelantado, nunca mientras esperas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto no momento em que você abre o app — feito com antecedência, nunca enquanto você espera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit in dem Moment, in dem du die App öffnest — im Voraus erstellt, nie während du wartest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt dès que vous ouvrez l'app — créé à l'avance, jamais pendant que vous attendez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronti nel momento in cui apri l'app — creati in anticipo, mai mentre aspetti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaar op het moment dat je de app opent — vooraf gemaakt, nooit terwijl je wacht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開いた瞬間に準備完了 — 事前に作成され、待たされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 여는 순간 준비 완료 — 미리 만들어 두어 기다릴 필요가 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打开应用的那一刻就已准备好——提前生成，绝不让你等待。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你打開 App 的那一刻就已準備好——提前製作，絕不讓你等待。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جاهزة لحظة فتح التطبيق — مصنوعة مسبقًا، وليس أبدًا أثناء انتظارك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप खोलते ही तैयार — पहले से बनी हुई, कभी आपके इंतज़ार के दौरान नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siap begitu kamu membuka aplikasi — dibuat lebih awal, tidak pernah saat kamu menunggu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı açtığın anda hazır — önceden oluşturulur, asla beklerken değil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe w chwili otwarcia aplikacji — tworzone z wyprzedzeniem, nigdy podczas oczekiwania."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово в тот момент, когда вы открываете приложение — создано заранее, а не пока вы ждёте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redo i samma ögonblick som du öppnar appen — skapade i förväg, aldrig medan du väntar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พร้อมทันทีที่คุณเปิดแอป — สร้างไว้ล่วงหน้า ไม่ต้องรอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẵn sàng ngay khi bạn mở ứng dụng — được tạo trước, không bao giờ trong lúc bạn chờ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово в момент, коли ви відкриваєте застосунок — створено заздалегідь, ніколи під час очікування."
          }
        }
      }
    },
    "mim_band_stalled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is taking longer than usual. Your ready looks are already in your outfits — the rest are still being made."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto está tardando más de lo habitual. Tus looks listos ya están en tus conjuntos; el resto se sigue creando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso está demorando mais que o normal. Seus visuais prontos já estão nas suas roupas — os demais ainda estão sendo criados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das dauert länger als üblich. Deine fertigen Looks sind bereits in deinen Outfits — der Rest wird noch erstellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela prend plus de temps que d'habitude. Vos looks prêts sont déjà dans vos tenues — les autres sont encore en création."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta richiedendo più tempo del solito. I tuoi look pronti sono già nei tuoi outfit — gli altri sono ancora in creazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit duurt langer dan gebruikelijk. Je klaargemaakte looks staan al in je outfits — de rest wordt nog gemaakt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常より時間がかかっています。用意できたルックはすでにコーディネートにあります — 残りは作成中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소보다 오래 걸리고 있습니다. 준비된 룩은 이미 아웃핏에 있습니다 — 나머지는 아직 만들어지는 중입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这比平时花的时间更长。你已准备好的造型已经在你的穿搭中了——其余的还在生成中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這比平常花了更久時間。你已準備好的造型已經在你的裝扮裡了——其餘的還在製作中。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستغرق هذا وقتًا أطول من المعتاد. إطلالاتك الجاهزة موجودة أصلًا في إطلالاتك — والبقية ما تزال تُصنع."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें सामान्य से ज़्यादा समय लग रहा है। आपके तैयार लुक पहले से आपकी आउटफ़िट में हैं — बाकी अभी बनाए जा रहे हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memakan waktu lebih lama dari biasanya. Tampilanmu yang siap sudah ada di outfitmu — sisanya masih dibuat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, her zamankinden uzun sürüyor. Hazır görünümlerin zaten kombinlerinde — geri kalanı hâlâ oluşturuluyor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa to dłużej niż zwykle. Twoje gotowe wyglądy są już w Twoich strojach — pozostałe są nadal tworzone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это занимает больше времени, чем обычно. Ваши готовые образы уже в ваших комплектах — остальные ещё создаются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här tar längre tid än vanligt. Dina färdiga looks finns redan i dina outfits — resten skapas fortfarande."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เวลานานกว่าปกติ ลุคที่พร้อมแล้วอยู่ในชุดของคุณแล้ว — ส่วนที่เหลือยังกำลังสร้าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này đang mất lâu hơn thường lệ. Các diện mạo sẵn sàng của bạn đã có trong trang phục của bạn — phần còn lại vẫn đang được tạo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це займає довше, ніж зазвичай. Ваші готові образи вже у ваших образах — решта ще створюється."
          }
        }
      }
    },
    "mim_band_unlimited_line": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every outfit, every day — no number to run out of."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada conjunto, cada día: sin ningún número que se agote."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as roupas, todos os dias — sem um número para esgotar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Outfit, jeden Tag — keine Anzahl, die ausgehen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque tenue, chaque jour — aucun nombre à épuiser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni outfit, ogni giorno — nessun limite da esaurire."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke outfit, elke dag — geen aantal dat op kan raken."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのコーディネートを毎日 — 上限を気にする必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 모든 아웃핏 — 소진될 횟수가 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天每套穿搭——没有会用完的次数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每一套裝扮，每一天——沒有會用完的數量。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل إطلالة، كل يوم — لا عدد ينفد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर आउटफ़िट, हर दिन — कोई संख्या ख़त्म होने वाली नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap outfit, setiap hari — tidak ada jumlah yang akan habis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün her kombin — bitecek bir sayı yok."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy strój, każdego dnia — bez limitu do wyczerpania."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый комплект, каждый день — без лимита, который может закончиться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje outfit, varje dag — inget antal som kan ta slut."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกชุด ทุกวัน — ไม่มีจำนวนให้ใช้หมด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi trang phục, mọi ngày — không có giới hạn nào để dùng hết."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен образ, щодня — без ліміту, який може закінчитися."
          }
        }
      }
    },
    "mim_camera_denied_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off for RunWear. You can turn it on in Settings, or choose from your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara está desactivado para RunWear. Puedes activarlo en Ajustes, o elegir de tu biblioteca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera está desativado para o RunWear. Você pode ativá-lo em Configurações ou escolher da sua biblioteca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugriff ist für RunWear aus. Du kannst ihn in den Einstellungen einschalten oder aus deiner Bibliothek wählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à l'appareil photo est désactivé pour RunWear. Vous pouvez l'activer dans Réglages, ou choisir dans votre bibliothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alla fotocamera è disattivato per RunWear. Puoi attivarlo nelle Impostazioni, oppure scegli dalla tua libreria."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cameratoegang staat uit voor RunWear. Je kunt hem inschakelen in Instellingen, of kies uit je bibliotheek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWearのカメラへのアクセスがオフです。設定でオンにするか、ライブラリから選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear의 카메라 접근이 꺼져 있습니다. 설정에서 켜거나, 라이브러리에서 선택할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear 的相机访问已关闭。你可以在“设置”中打开它，或者从你的相册中选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear 的相機存取已關閉。你可以在「設定」中開啟，或從你的圖庫中選擇。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الكاميرا معطّل لـ RunWear. يمكنك تفعيله في الإعدادات، أو الاختيار من مكتبتك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear के लिए कैमरा एक्सेस बंद है। आप इसे Settings में चालू कर सकते हैं, या अपनी लाइब्रेरी से चुन सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kamera nonaktif untuk RunWear. Kamu dapat mengaktifkannya di Pengaturan, atau pilih dari pustakamu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear için kamera erişimi kapalı. Ayarlar'dan açabilir veya kitaplığından seçebilirsin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do aparatu jest wyłączony dla RunWear. Możesz włączyć go w Ustawieniach albo wybrać z biblioteki."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к камере выключен для RunWear. Его можно включить в настройках или выбрать из библиотеки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraåtkomst är av för RunWear. Du kan slå på den i Inställningar, eller välja från ditt bibliotek."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงกล้องปิดอยู่สำหรับ RunWear คุณสามารถเปิดได้ในการตั้งค่า หรือเลือกจากคลังของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập camera đang tắt cho RunWear. Bạn có thể bật nó trong Cài đặt, hoặc chọn từ thư viện của bạn."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до камери вимкнено для RunWear. Ви можете ввімкнути його в Налаштуваннях або вибрати зі своєї бібліотеки."
          }
        }
      }
    },
