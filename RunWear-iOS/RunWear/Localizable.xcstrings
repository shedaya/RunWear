    "sheet_time_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every hour can be chosen — the handle snaps hour to hour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se puede elegir cualquier hora: el control avanza hora a hora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as horas podem ser escolhidas — o controle avança de hora em hora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Stunde kann gewählt werden — der Griff rastet von Stunde zu Stunde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque heure peut être choisie — le curseur passe d'heure en heure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni ora può essere scelta — la maniglia scatta di ora in ora."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk uur kan worden gekozen — de greep klikt van uur naar uur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての時間を選べます — ハンドルは1時間ごとにスナップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 시간을 선택할 수 있습니다 — 핸들이 시간 단위로 맞춰집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个小时都可以选择——手柄会逐小时吸附。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個小時都可以選擇——把手會逐小時吸附。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن اختيار كل ساعة — ينتقل المقبض من ساعة إلى ساعة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर घंटा चुना जा सकता है — हैंडल घंटे से घंटे पर टिकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap jam dapat dipilih — pegangan berpindah dari jam ke jam."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her saat seçilebilir — tutamaç saatten saate oturur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdą godzinę można wybrać — uchwyt przeskakuje co godzinę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно выбрать любой час — ползунок перемещается по часам."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje timme kan väljas — handtaget snäpper från timme till timme."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกชั่วโมงเลือกได้ — ตัวเลื่อนจะหยุดทีละชั่วโมง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi giờ đều có thể chọn — tay cầm khớp theo từng giờ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна вибрати кожну годину — повзунок перескакує погодинно."
          }
        }
      }
    },
