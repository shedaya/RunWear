          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低濕度可能在不知不覺中讓你脫水。在感到口渴之前就喝水。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرطوبة المنخفضة قد تسبب جفافًا خادعًا. اشرب قبل أن تشعر بالعطش."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम आर्द्रता धोखे से निर्जलीकरण कर सकती है। प्यास लगने से पहले पानी पिएं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelembapan rendah bisa diam-diam menyebabkan dehidrasi. Minum sebelum kamu merasa haus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük nem, fark ettirmeden susuz bırakabilir. Susamadan önce iç."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niska wilgotność może podstępnie odwadniać. Pij, zanim poczujesz pragnienie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Низкая влажность может незаметно обезвоживать. Пейте до того, как почувствуете жажду."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låg luftfuktighet kan vara lömskt uttorkande. Drick innan du känner dig törstig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความชื้นต่ำอาจทำให้ขาดน้ำโดยไม่รู้ตัว ดื่มก่อนรู้สึกกระหาย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ ẩm thấp có thể gây mất nước một cách âm thầm. Uống trước khi bạn cảm thấy khát."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Низька вологість може непомітно зневоднювати. Пийте, перш ніж відчуєте спрагу."
          }
        }
      }
    },
    "tip_rain_gear": {
      "extractionState": "manual",
      "localizations": {
