    "onb_headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run, weather or not."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corre, llueva o truene."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corra, com qualquer clima."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufen, egal welches Wetter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courez, qu'il fasse beau ou non."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corri, qualunque sia il meteo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hardlopen, weer of geen weer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "走ろう、天気にかかわらず。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날씨와 상관없이, 러닝."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跑步，无论天气如何。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跑吧，天氣無阻。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجرِ، مهما كان الطقس."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दौड़ें, मौसम हो या न हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lari, apa pun cuacanya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava ne olursa olsun koş."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biegaj, bez względu na pogodę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бегите — в любую погоду."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spring, oavsett väder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วิ่ง ไม่ว่าสภาพอากาศจะเป็นอย่างไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy, bất kể thời tiết."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бігайте, незалежно від погоди."
          }
        }
      }
    },
    "onb_location_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear saves your most recent location on your phone so your outfit is ready when you open the app. For a forecast, it sends coordinates rounded to a rough area — never your exact spot — and your location is never sold or used for advertising."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear guarda tu ubicación más reciente en tu teléfono para que tu conjunto esté listo cuando abras la app. Para un pronóstico, envía coordenadas redondeadas a una zona aproximada (nunca tu lugar exacto), y tu ubicación nunca se vende ni se usa para publicidad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O RunWear salva sua localização mais recente no seu celular para que sua roupa esteja pronta quando você abrir o app. Para uma previsão, ele envia coordenadas arredondadas para uma área aproximada — nunca seu local exato — e sua localização nunca é vendida nem usada para publicidade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear speichert deinen letzten Standort auf deinem Telefon, damit dein Outfit bereit ist, wenn du die App öffnest. Für eine Vorhersage sendet es Koordinaten, gerundet auf ein grobes Gebiet — nie deinen exakten Ort — und dein Standort wird nie verkauft oder für Werbung verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear enregistre votre localisation la plus récente sur votre téléphone pour que votre tenue soit prête quand vous ouvrez l'app. Pour des prévisions, il envoie des coordonnées arrondies à une zone approximative — jamais votre position exacte — et votre localisation n'est jamais vendue ni utilisée pour la publicité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear salva la tua posizione più recente sul telefono, così il tuo outfit è pronto quando apri l'app. Per una previsione, invia coordinate arrotondate a un'area approssimativa — mai il tuo punto esatto — e la tua posizione non viene mai venduta né usata per pubblicità."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear bewaart je meest recente locatie op je telefoon, zodat je outfit klaar is wanneer je de app opent. Voor een verwachting stuurt het coördinaten afgerond op een globaal gebied — nooit je exacte plek — en je locatie wordt nooit verkocht of gebruikt voor advertenties."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWearは直近の位置情報をスマートフォンに保存し、アプリを開いたときにコーディネートがすぐ見られるようにします。予報のため、大まかな地域に丸めた座標を送信します — 正確な場所が送られることは決してありません。また、位置情報が販売されたり、広告に使われたりすることも決してありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear는 가장 최근 위치를 휴대폰에 저장하므로, 앱을 열면 아웃핏이 준비되어 있습니다. 예보를 위해 대략적인 지역으로 반올림한 좌표를 보내며 — 정확한 지점은 절대 보내지 않습니다 — 위치는 절대 판매되거나 광고에 사용되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear 会将你最近的位置保存在你的手机上，这样你打开应用时穿搭就已准备好。为了预报，它会发送四舍五入到大致区域的坐标——绝不会是你确切的位置——你的位置绝不会被出售或用于广告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear 會將你最近的位置保存在你的手機上，讓你打開 App 時裝扮已經準備好。為了取得預報，它會傳送四捨五入到大致區域的座標——絕不是你的確切位置——而且你的位置絕不會被出售或用於廣告。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ RunWear أحدث موقع لك على هاتفك لتكون إطلالتك جاهزة عند فتح التطبيق. وللتوقعات، يرسل إحداثيات مقربة إلى منطقة تقريبية — لا موقعك الدقيق أبدًا — ولا يُباع موقعك أبدًا ولا يُستخدم للإعلانات."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear आपका सबसे हाल का स्थान आपके फ़ोन पर सहेजता है ताकि ऐप खोलने पर आपकी आउटफ़िट तैयार मिले। पूर्वानुमान के लिए, यह एक मोटे क्षेत्र तक गोल किए गए निर्देशांक भेजता है — कभी आपका सटीक स्थान नहीं — और आपका स्थान कभी बेचा नहीं जाता और न ही विज्ञापन के लिए इस्तेमाल होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear menyimpan lokasi terakhirmu di ponselmu agar outfitmu siap saat kamu membuka aplikasi. Untuk prakiraan, ia mengirim koordinat yang dibulatkan ke area kasar — tidak pernah titik persismu — dan lokasimu tidak pernah dijual atau digunakan untuk iklan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear, en son konumunu telefonuna kaydeder, böylece uygulamayı açtığında kombinin hazır olur. Tahmin için, kabaca bir alana yuvarlanmış koordinatlar gönderir — asla tam noktanı değil — ve konumun asla satılmaz veya reklam için kullanılmaz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear zapisuje Twoją najnowszą lokalizację na Twoim telefonie, aby Twój strój był gotowy, gdy otworzysz aplikację. Na potrzeby prognozy wysyła współrzędne zaokrąglone do przybliżonego obszaru — nigdy Twojego dokładnego miejsca — a Twoja lokalizacja nigdy nie jest sprzedawana ani używana do reklam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear сохраняет вашу самую недавнюю геолокацию на вашем телефоне, чтобы ваш комплект был готов, когда вы откроете приложение. Для прогноза он отправляет координаты, округлённые до приблизительной области, — никогда не ваше точное место, — а ваша геолокация никогда не продаётся и не используется для рекламы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear sparar din senaste plats på din telefon så att din outfit är redo när du öppnar appen. För en prognos skickar den koordinater avrundade till ett ungefärligt område — aldrig din exakta plats — och din plats säljs aldrig eller används för annonsering."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear บันทึกตำแหน่งล่าสุดของคุณไว้ในโทรศัพท์เพื่อให้ชุดของคุณพร้อมเมื่อคุณเปิดแอป สำหรับพยากรณ์ มันส่งพิกัดที่ปัดเศษเป็นพื้นที่คร่าว ๆ — ไม่ใช่จุดที่แน่นอนของคุณ — และตำแหน่งของคุณไม่ถูกขายหรือใช้เพื่อโฆษณา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear lưu vị trí gần nhất của bạn trên điện thoại để trang phục của bạn sẵn sàng khi bạn mở ứng dụng. Để dự báo, nó gửi tọa độ được làm tròn đến một khu vực đại khái — không bao giờ là vị trí chính xác của bạn — và vị trí của bạn không bao giờ được bán hoặc dùng cho quảng cáo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear зберігає ваше останнє місцезнаходження на вашому телефоні, щоб ваш образ був готовий, коли ви відкриєте застосунок. Для прогнозу він надсилає координати, округлені до приблизної області — ніколи не ваше точне місце — і ваше місцезнаходження ніколи не продається й не використовується для реклами."
          }
        }
      }
    },
