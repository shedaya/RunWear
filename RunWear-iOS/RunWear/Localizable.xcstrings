    "settings_temp_unit_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for today's outfit, the hourly chart, and your watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para el conjunto de hoy, el gráfico por horas y tu reloj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para a roupa de hoje, o gráfico por hora e seu relógio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für das heutige Outfit, das Stundendiagramm und deine Uhr verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisée pour la tenue du jour, le graphique horaire et votre montre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usata per l'outfit di oggi, il grafico orario e il tuo orologio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt voor de outfit van vandaag, de uurgrafiek en je horloge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のコーディネート、時間別グラフ、ウォッチで使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 아웃핏, 시간별 차트, 워치에 사용됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于今天的穿搭、逐小时图表和你的手表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於今天的裝扮、每小時圖表和你的手錶。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم لإطلالة اليوم، والرسم البياني بالساعة، وساعتك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की आउटफ़िट, घंटेवार चार्ट और आपकी घड़ी के लिए इस्तेमाल होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan untuk outfit hari ini, grafik per jam, dan jam tanganmu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü kombin, saatlik grafik ve saatin için kullanılır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używane w dzisiejszym stroju, wykresie godzinowym i na Twoim zegarku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется для сегодняшнего комплекта, почасового графика и ваших часов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Används för dagens outfit, timdiagrammet och din klocka."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้สำหรับชุดวันนี้ แผนภูมิรายชั่วโมง และนาฬิกาของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng cho trang phục hôm nay, biểu đồ theo giờ, và đồng hồ của bạn."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується для сьогоднішнього образу, погодинного графіка й вашого годинника."
          }
        }
      }
    },
