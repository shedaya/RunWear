          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法刪除你的資料。請重試。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حذف بياناتك. حاول مجددًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका डेटा हटाया नहीं जा सका। कृपया फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Datamu tidak dapat dihapus. Silakan coba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilerin silinemedi. Lütfen tekrar dene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się usunąć Twoich danych. Spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
