    "onb_promise_2_phrase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture yourself at the start line with the perfect outfit ready to go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
