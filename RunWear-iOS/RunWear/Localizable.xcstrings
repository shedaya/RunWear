    "onb_location_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear saves your most recent location on your phone so your outfit is ready when you open the app. For a forecast, it sends coordinates rounded to a rough area — never your exact spot — and your location is never sold or used for advertising."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear guarda tu ubicación más reciente en tu teléfono para que tu conjunto esté listo cuando abras la app. Para un pronóstico, envía coordenadas redondeadas a una zona aproximada (nunca tu lugar exacto), y tu ubicación nunca se vende ni se usa para publicidad."
          }
        }
      }
    },
