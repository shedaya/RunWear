    "view_forecast_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forecast isn't available for that time yet — showing current conditions. (%1$@, %2$@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pronóstico aún no está disponible para esa hora: se muestran las condiciones actuales. (%1$@, %2$@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A previsão ainda não está disponível para esse horário — mostrando as condições atuais. (%1$@, %2$@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorhersage ist für diese Zeit noch nicht verfügbar — aktuelle Bedingungen werden gezeigt. (%1$@, %2$@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prévisions ne sont pas encore disponibles pour ce moment — affichage des conditions actuelles. (%1$@, %2$@)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le previsioni non sono ancora disponibili per quell'ora — mostro le condizioni attuali. (%1$@, %2$@)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verwachting is nog niet beschikbaar voor die tijd — huidige omstandigheden worden getoond. (%1$@, %2$@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その時刻の予報はまだ利用できません — 現在の状況を表示しています。（%1$@、%2$@）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 시간의 예보는 아직 사용할 수 없습니다 — 현재 조건을 표시합니다. (%1$@, %2$@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那个时间的预报还不可用——显示当前状况。(%1$@，%2$@)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該時間的預報尚無法使用——改為顯示目前狀況。(%1$@，%2$@)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التوقعات غير متاحة لذلك الوقت بعد — تُعرض الظروف الحالية. (%1$@، %2$@)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस समय के लिए पूर्वानुमान अभी उपलब्ध नहीं है — वर्तमान स्थितियाँ दिखाई जा रही हैं। (%1$@, %2$@)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prakiraan belum tersedia untuk waktu itu — menampilkan kondisi saat ini. (%1$@, %2$@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O saat için tahmin henüz yok — mevcut koşullar gösteriliyor. (%1$@, %2$@)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prognoza nie jest jeszcze dostępna na ten czas — pokazano bieżące warunki. (%1$@, %2$@)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогноз для этого времени пока недоступен — показаны текущие условия. (%1$@, %2$@)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prognosen är inte tillgänglig för den tiden än — visar aktuella förhållanden. (%1$@, %2$@)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พยากรณ์ยังไม่พร้อมสำหรับเวลานั้น — แสดงสภาพปัจจุบัน (%1$@, %2$@)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dự báo chưa khả dụng cho thời gian đó — đang hiển thị điều kiện hiện tại. (%1$@, %2$@)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогноз для того часу ще недоступний — показуємо поточні умови. (%1$@, %2$@)"
          }
        }
      }
    },
