    "settings_help_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We count how the app is used — which features get used and where recommendations miss — and nothing else. No account, no advertising ID, and your location never leaves the phone more precisely than the city name. Turn this off and nothing is counted or sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contamos cómo se usa la app (qué funciones se usan y dónde fallan las recomendaciones) y nada más. Sin cuenta, sin identificador publicitario, y tu ubicación nunca sale del teléfono con más precisión que el nombre de la ciudad. Desactívalo y no se contará ni se enviará nada."
          }
        }
      }
    },
