          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina rekommendationer, med dig på fotot."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำแนะนำของคุณ พร้อมตัวคุณในรูปภาพ"
