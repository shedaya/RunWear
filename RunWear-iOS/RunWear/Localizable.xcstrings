    "mim_scaffold_badge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This look was made for similar weather — your exact one is being made."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este look se creó para un tiempo parecido: el tuyo exacto se está creando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este visual foi feito para um clima parecido — o seu exato está sendo criado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Look wurde für ähnliches Wetter erstellt — dein exakter wird gerade erstellt."
