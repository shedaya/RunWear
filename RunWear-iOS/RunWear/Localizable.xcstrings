    "share_disclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As an Amazon Associate, RunWear earns from qualifying purchases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como Asociado de Amazon, RunWear gana con las compras que cumplan los requisitos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como Associado da Amazon, o RunWear ganha com compras qualificadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Amazon-Partner verdient RunWear an qualifizierten Käufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En tant qu'associé Amazon, RunWear perçoit des revenus sur les achats éligibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In qualità di Associato Amazon, RunWear guadagna dagli acquisti idonei."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Amazon-partner verdient RunWear aan in aanmerking komende aankopen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Amazonアソシエイトとして、RunWearは対象の購入から収益を得ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Amazon 어소시에이트로서 RunWear는 적격 구매를 통해 수익을 얻습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作为 Amazon Associate，RunWear 从符合条件的购买中获得收益。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "作為 Amazon 合作夥伴，RunWear 從符合資格的購買中賺取收益。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بصفته شريكًا في Amazon، يحقق RunWear أرباحًا من عمليات الشراء المؤهلة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Amazon Associate के रूप में, RunWear योग्य खरीदारी से कमाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagai Amazon Associate, RunWear memperoleh pendapatan dari pembelian yang memenuhi syarat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amazon İş Ortağı olarak RunWear, uygun satın alımlardan kazanç elde eder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jako partner Amazon, RunWear zarabia na kwalifikujących się zakupach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как партнёр Amazon, RunWear зарабатывает на соответствующих требованиям покупках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Som Amazon Associate tjänar RunWear på kvalificerade köp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในฐานะ Amazon Associate, RunWear ได้รับรายได้จากการซื้อที่เข้าเงื่อนไข"
