    "mim_progress_subline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This usually takes a few minutes — the standard photo stays up until yours is done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto suele tardar unos minutos: la foto estándar permanece hasta que la tuya esté lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso geralmente leva alguns minutos — a foto padrão fica visível até a sua ficar pronta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das dauert normalerweise ein paar Minuten — das Standardfoto bleibt, bis deines fertig ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela prend généralement quelques minutes — la photo standard reste affichée jusqu'à ce que la vôtre soit prête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di solito richiede qualche minuto — la foto standard resta finché la tua non è pronta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit duurt meestal een paar minuten — de standaardfoto blijft staan totdat die van jou klaar is."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常は数分かかります — あなたの写真ができるまで標準の写真が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보통 몇 분 정도 걸립니다 — 내 사진이 완성될 때까지 기본 사진이 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这通常需要几分钟——你的照片完成之前，会先显示标准照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這通常需要幾分鐘——在你的照片完成之前，會先顯示標準照片。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستغرق هذا عادة بضع دقائق — تبقى الصورة القياسية حتى تجهز صورتك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें आमतौर पर कुछ मिनट लगते हैं — आपकी फ़ोटो तैयार होने तक मानक फ़ोटो बनी रहती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini biasanya memakan waktu beberapa menit — foto standar tetap tampil hingga fotomu selesai."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu genellikle birkaç dakika sürer — seninki hazır olana kadar standart fotoğraf kalır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwykle trwa to kilka minut — standardowe zdjęcie pozostaje, aż Twoje będzie gotowe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычно это занимает несколько минут — стандартное фото остаётся, пока ваше не будет готово."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det brukar ta några minuter — standardfotot visas tills ditt är klart."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โดยปกติใช้เวลาสองสามนาที — รูปมาตรฐานจะแสดงอยู่จนกว่ารูปของคุณจะเสร็จ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này thường mất vài phút — ảnh tiêu chuẩn vẫn hiển thị cho đến khi ảnh của bạn xong."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зазвичай це займає кілька хвилин — стандартне фото залишається, доки ваше не буде готове."
          }
        }
      }
    },
