    "tip_humidity_high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High humidity makes it harder to cool down. Slow your pace and hydrate frequently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La humedad alta hace más difícil refrescarse. Baja tu ritmo e hidrátate con frecuencia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Umidade alta dificulta o resfriamento. Reduza seu ritmo e hidrate-se com frequência."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hohe Luftfeuchtigkeit macht es schwerer, abzukühlen. Verlangsame dein Tempo und trinke häufig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une humidité élevée rend le refroidissement plus difficile. Ralentissez votre allure et hydratez-vous fréquemment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'umidità elevata rende più difficile raffreddarsi. Rallenta il ritmo e idratati spesso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoge luchtvochtigheid maakt het moeilijker om af te koelen. Vertraag je tempo en drink regelmatig."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "湿度が高いと体が冷えにくくなります。ペースを落として、こまめに水分補給を。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높은 습도는 체온을 식히기 어렵게 합니다. 페이스를 늦추고 자주 수분을 섭취하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "湿度高会让降温更难。放慢配速并频繁补水。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高濕度讓降溫更困難。放慢步調並經常補水。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرطوبة المرتفعة تجعل التبريد أصعب. أبطئ سرعتك واشرب بشكل متكرر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उच्च आर्द्रता से ठंडा होना कठिन हो जाता है। अपनी गति धीमी करें और बार-बार पानी पिएं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelembapan tinggi membuatmu lebih sulit mendinginkan tubuh. Perlambat temponmu dan sering minum."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek nem, serinlemeyi zorlaştırır. Temponu yavaşlat ve sık sık su iç."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysoka wilgotność utrudnia chłodzenie. Zwolnij tempo i często się nawadniaj."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высокая влажность затрудняет охлаждение. Замедлите темп и пейте часто."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hög luftfuktighet gör det svårare att kyla ner sig. Sakta ner tempot och drick ofta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความชื้นสูงทำให้ระบายความร้อนยากขึ้น ชะลอจังหวะและดื่มน้ำบ่อย ๆ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ ẩm cao khiến việc hạ nhiệt khó hơn. Giảm tốc độ và uống nước thường xuyên."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Висока вологість ускладнює охолодження. Уповільніть темп і часто пийте."
          }
        }
      }
    },
    "tip_humidity_low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low humidity can be deceptively dehydrating. Drink before you feel thirsty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La humedad baja puede deshidratar sin que te des cuenta. Bebe antes de tener sed."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Umidade baixa pode desidratar sem você perceber. Beba antes de sentir sede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedrige Luftfeuchtigkeit kann täuschend austrocknen. Trinke, bevor du Durst verspürst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une humidité faible peut déshydrater insidieusement. Buvez avant d'avoir soif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'umidità bassa può disidratare senza che te ne accorga. Bevi prima di avere sete."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lage luchtvochtigheid kan verraderlijk uitdrogend zijn. Drink voordat je dorst krijgt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "湿度が低いと、気づかないうちに脱水することがあります。喉が渇く前に飲みましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
