    "mimset_new_photo_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retake your selfie and new looks are made from the new photo. Looks already saved in Wear I've Run stay exactly as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a hacerte el selfi y los nuevos looks se crearán a partir de la nueva foto. Los looks ya guardados en Wear I've Run se quedan exactamente como están."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire sua selfie de novo e novos visuais serão criados a partir da nova foto. Os visuais já salvos em Wear I've Run permanecem exatamente como estão."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm dein Selfie neu auf, und neue Looks werden aus dem neuen Foto erstellt. Looks, die bereits in Wear I've Run gespeichert sind, bleiben genau so, wie sie sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprenez votre selfie et de nouveaux looks sont créés à partir de la nouvelle photo. Les looks déjà enregistrés dans Wear I've Run restent exactement tels quels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rifai il selfie e i nuovi look vengono creati dalla nuova foto. I look già salvati in Wear I've Run restano esattamente come sono."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak je selfie opnieuw en nieuwe looks worden van de nieuwe foto gemaakt. Looks die al in Wear I've Run zijn opgeslagen, blijven precies zoals ze zijn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自撮りを撮り直すと、新しい写真から新しいルックが作成されます。Wear I've Runにすでに保存されたルックはそのまま変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셀카를 다시 찍으면 새 사진으로 새 룩이 만들어집니다. Wear I've Run에 이미 저장된 룩은 그대로 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重拍你的自拍，新造型会根据新照片生成。已经保存在 Wear I've Run 中的造型保持原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新拍你的自拍，新的造型會用新照片製作。已保存在 Wear I've Run 中的造型保持原樣。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد التقاط سيلفي لك وستُصنع إطلالات جديدة من الصورة الجديدة. الإطلالات المحفوظة أصلًا في Wear I've Run تبقى كما هي تمامًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी सेल्फ़ी फिर से लें और नई फ़ोटो से नए लुक बनाए जाते हैं। Wear I've Run में पहले से सहेजे लुक बिल्कुल वैसे ही रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil ulang selfiemu dan tampilan baru dibuat dari foto baru itu. Tampilan yang sudah disimpan di Wear I've Run tetap persis seperti sebelumnya."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selfie'ni yeniden çek; yeni görünümler yeni fotoğraftan oluşturulur. Wear I've Run'da zaten kayıtlı görünümler aynen kalır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób selfie jeszcze raz, a nowe wyglądy powstaną z nowego zdjęcia. Wyglądy już zapisane w Wear I've Run pozostają dokładnie takie, jakie są."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переснимите селфи, и новые образы будут создаваться из нового фото. Образы, уже сохранённые в Wear I've Run, остаются точно такими же."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta om din selfie så skapas nya looks från det nya fotot. Looks som redan sparats i Wear I've Run förblir exakt som de är."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายเซลฟี่ใหม่แล้วลุคใหม่จะสร้างจากรูปใหม่ ลุคที่บันทึกไว้แล้วใน Wear I've Run จะคงอยู่อย่างเดิม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp lại ảnh selfie của bạn và các diện mạo mới được tạo từ ảnh mới. Các diện mạo đã lưu trong Wear I've Run vẫn giữ nguyên như cũ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перефотографуйте селфі, і нові образи створюватимуться з нового фото. Образи, уже збережені у Wear I've Run, залишаються точно такими, як є."
          }
        }
      }
    },
    "mimset_new_photo_head": {
