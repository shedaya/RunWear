    "settings_crash_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the app crashes, it can send us the technical details so we can fix it. This happens only after a crash, and only with your permission here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la app se cierra inesperadamente, puede enviarnos los detalles técnicos para que podamos corregirlo. Esto ocurre solo después de un cierre, y solo con tu permiso aquí."
          }
        }
      }
    },
