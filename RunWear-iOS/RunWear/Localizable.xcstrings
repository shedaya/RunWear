    "flow_consent_upload": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear will upload your photos to our server. They're used for one thing only: making pictures of you wearing your recommended outfits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear subirá tus fotos a nuestro servidor. Se usan para una sola cosa: crear imágenes tuyas con los conjuntos recomendados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O RunWear enviará suas fotos para nosso servidor. Elas são usadas para uma única coisa: criar imagens de você usando suas roupas recomendadas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear lädt deine Fotos auf unseren Server hoch. Sie werden nur für eines verwendet: Bilder von dir zu erstellen, auf denen du deine empfohlenen Outfits trägst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear enverra vos photos sur notre serveur. Elles ne servent qu'à une chose : créer des images de vous portant vos tenues recommandées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear caricherà le tue foto sul nostro server. Vengono usate per una cosa sola: creare immagini di te con gli outfit consigliati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear uploadt je foto's naar onze server. Ze worden voor slechts één ding gebruikt: foto's maken van jou in je aanbevolen outfits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWearはあなたの写真をサーバーにアップロードします。用途は1つだけです。おすすめのコーディネートを着たあなたの画像を作成することです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear는 사용자의 사진을 서버에 업로드합니다. 사진은 단 한 가지 목적으로만 사용됩니다: 추천 아웃핏을 입은 사용자의 모습을 만드는 것입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear 会将你的照片上传到我们的服务器。它们只用于一件事：生成你穿着推荐穿搭的图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear 會將你的照片上傳到我們的伺服器。它們只有一個用途：製作你穿著推薦裝扮的照片。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيحمّل RunWear صورك إلى خادمنا. تُستخدم لغرض واحد فقط: صنع صور لك وأنت ترتدي الإطلالات الموصى بها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear आपकी फ़ोटो हमारे सर्वर पर अपलोड करेगा। उनका इस्तेमाल सिर्फ़ एक ही चीज़ के लिए होता है: आपकी सुझाई गई आउटफ़िट पहने हुए आपकी तस्वीरें बनाना।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear akan mengunggah fotomu ke server kami. Foto itu hanya digunakan untuk satu hal: membuat gambar dirimu mengenakan outfit yang direkomendasikan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear, fotoğraflarını sunucumuza yükleyecek. Bunlar yalnızca tek bir amaçla kullanılır: önerilen kombinleri giydiğin resimlerini oluşturmak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear prześle Twoje zdjęcia na nasz serwer. Są używane tylko do jednego: tworzenia zdjęć, na których masz na sobie zalecane stroje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear загрузит ваши фотографии на наш сервер. Они используются только для одного: создания изображений, где вы в рекомендованных вам комплектах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear laddar upp dina foton till vår server. De används till en enda sak: att skapa bilder av dig i dina rekommenderade outfits."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear จะอัปโหลดรูปภาพของคุณไปยังเซิร์ฟเวอร์ของเรา รูปภาพเหล่านี้ใช้เพื่อสิ่งเดียวเท่านั้น คือสร้างรูปของคุณที่สวมชุดที่แนะนำ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear sẽ tải ảnh của bạn lên máy chủ của chúng tôi. Chúng chỉ được dùng cho một việc duy nhất: tạo ảnh bạn mặc các trang phục được gợi ý."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear завантажить ваші фото на наш сервер. Вони використовуються лише для одного: створення зображень, на яких ви вдягнені у рекомендовані образи."
          }
        }
      }
    },
