    "flow_attestation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These photos are of me, and I am 18 or older."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas fotos son mías y tengo 18 años o más."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas fotos são minhas e eu tenho 18 anos ou mais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Fotos zeigen mich, und ich bin 18 oder älter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces photos sont de moi, et j'ai 18 ans ou plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste foto ritraggono me e ho almeno 18 anni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze foto's zijn van mij, en ik ben 18 jaar of ouder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの写真は私自身のものであり、私は18歳以上です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진은 본인의 사진이며, 본인은 만 18세 이상입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些照片是我本人的，而且我已年满 18 岁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些照片是我本人的，而且我已年滿 18 歲。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الصور لي، وعمري 18 عامًا أو أكثر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये फ़ोटो मेरी हैं, और मेरी उम्र 18 वर्ष या उससे अधिक है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto-foto ini adalah foto saya, dan saya berusia 18 tahun atau lebih."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğraflar bana ait ve 18 yaşında veya daha büyüğüm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te zdjęcia przedstawiają mnie i mam 18 lat lub więcej."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этих фотографиях я, и мне 18 лет или больше."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessa foton föreställer mig, och jag är 18 år eller äldre."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพเหล่านี้เป็นรูปของฉัน และฉันอายุ 18 ปีขึ้นไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những ảnh này là của tôi, và tôi từ 18 tuổi trở lên."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цих фото я, і мені 18 років або більше."
          }
        }
      }
    },
