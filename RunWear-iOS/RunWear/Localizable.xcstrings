    "flow_consent_delete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can delete your photos and every picture made from them at any time: Settings → Make It Me → Delete my photos. Deleting is permanent and takes effect right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes eliminar tus fotos y todas las imágenes creadas a partir de ellas en cualquier momento: Ajustes → Make It Me → Eliminar mis fotos. La eliminación es permanente y tiene efecto inmediato."
          }
        }
      }
    },
    "flow_consent_kept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pictures made from your photos are kept only for you, so your outfits are ready when you open the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes creadas a partir de tus fotos se guardan solo para ti, para que tus conjuntos estén listos cuando abras la app."
          }
        }
      }
    },
    "flow_consent_never": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos are never used to train AI models. They're never shown to other users, never added to RunWear's standard photo library, and never shared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos nunca se usan para entrenar modelos de IA. Nunca se muestran a otros usuarios, nunca se añaden a la biblioteca de fotos estándar de RunWear y nunca se comparten."
          }
        }
      }
    },
    "flow_consent_nothing_else": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing else is done with them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se hace nada más con ellas."
          }
        }
      }
    },
    "flow_consent_upload": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear will upload your photos to our server. They're used for one thing only: making pictures of you wearing your recommended outfits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RunWear subirá tus fotos a nuestro servidor. Se usan para una sola cosa: crear imágenes tuyas con los conjuntos recomendados."
          }
        }
      }
    },
    "flow_different_photo": {
