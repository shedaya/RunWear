    "flow_replace_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacing your photos remakes today's look right away. Your other looks update as they're made again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al reemplazar tus fotos, el look de hoy se rehace enseguida. Tus demás looks se actualizan cuando se vuelven a crear."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir suas fotos recria o visual de hoje na hora. Seus outros visuais são atualizados quando forem criados de novo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ersetzen deiner Fotos erstellt den heutigen Look sofort neu. Deine anderen Looks werden aktualisiert, wenn sie neu erstellt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer vos photos recrée immédiatement le look d'aujourd'hui. Vos autres looks se mettent à jour lorsqu'ils sont recréés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituire le tue foto ricrea subito il look di oggi. Gli altri look si aggiornano quando vengono ricreati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je je foto's vervangt, wordt de look van vandaag direct opnieuw gemaakt. Je andere looks worden bijgewerkt zodra ze opnieuw worden gemaakt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を置き換えると、今日のルックはすぐに作り直されます。その他のルックは、再作成されるたびに更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 교체하면 오늘의 룩이 바로 다시 만들어집니다. 다른 룩은 다시 만들어질 때 업데이트됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更换照片会立即重新生成今天的造型。你的其他造型会在重新生成时更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更換照片會立即重新製作今天的造型。你的其他造型會在重新製作時更新。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدال صورك يعيد صنع إطلالة اليوم فورًا. وتتحدث إطلالاتك الأخرى عند إعادة صنعها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ोटो बदलने से आज का लुक तुरंत फिर से बन जाता है। आपके अन्य लुक तब अपडेट होते हैं जब वे फिर से बनाए जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengganti fotomu akan membuat ulang tampilan hari ini segera. Tampilanmu yang lain diperbarui saat dibuat ulang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflarını değiştirmek, bugünkü görünümü hemen yeniden oluşturur. Diğer görünümlerin, yeniden oluşturuldukça güncellenir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamiana zdjęć od razu tworzy dzisiejszy wygląd na nowo. Pozostałe wyglądy aktualizują się, gdy są tworzone ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замена фотографий сразу пересоздаёт сегодняшний образ. Остальные образы обновятся, когда будут созданы заново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du byter ut dina foton återskapas dagens look direkt. Dina andra looks uppdateras när de skapas igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปลี่ยนรูปภาพจะสร้างลุคของวันนี้ใหม่ทันที ลุคอื่น ๆ จะอัปเดตเมื่อสร้างอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc thay thế ảnh sẽ tạo lại diện mạo hôm nay ngay lập tức. Các diện mạo khác của bạn cập nhật khi chúng được tạo lại."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заміна ваших фото одразу перестворює сьогоднішній образ. Інші образи оновлюються, коли їх створюють знову."
          }
        }
      }
    },
