    "mimset_made_ahead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made ahead, without limit — every outfit is ready when you open the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creados por adelantado, sin límite: cada conjunto está listo cuando abres la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feito com antecedência, sem limite — todas as roupas estão prontas quando você abre o app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Voraus erstellt, ohne Limit — jedes Outfit ist bereit, wenn du die App öffnest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créées à l'avance, sans limite — chaque tenue est prête quand vous ouvrez l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creati in anticipo, senza limiti — ogni outfit è pronto quando apri l'app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vooraf gemaakt, zonder limiet — elke outfit is klaar wanneer je de app opent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "事前に、無制限に作成 — アプリを開いたとき、すべてのコーディネートが用意されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 만들어지고 제한 없이 — 앱을 열면 모든 아웃핏이 준비되어 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提前生成，不限次数——你打开应用时，每套穿搭都已准备好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提前製作、沒有限制——你打開 App 時，每套裝扮都已準備好。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصنوعة مسبقًا، دون حدود — كل إطلالة جاهزة عند فتح التطبيق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले से बनाया गया, बिना किसी सीमा के — ऐप खोलने पर हर आउटफ़िट तैयार मिलती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuat lebih awal, tanpa batas — setiap outfit siap saat kamu membuka aplikasi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceden oluşturulur, sınırsız — her kombin, uygulamayı açtığında hazır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tworzone z wyprzedzeniem, bez limitu — każdy strój jest gotowy, gdy otworzysz aplikację."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаётся заранее и без ограничений — каждый комплект готов, когда вы открываете приложение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapade i förväg, utan gräns — varje outfit är redo när du öppnar appen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างไว้ล่วงหน้า ไม่จำกัด — ทุกชุดพร้อมเมื่อคุณเปิดแอป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được tạo trước, không giới hạn — mọi trang phục sẵn sàng khi bạn mở ứng dụng."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створено заздалегідь, без обмежень — кожен образ готовий, коли ви відкриваєте застосунок."
          }
        }
      }
    },
