    "mim_subscription_line": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d of %2$d used · Free looks never expire — and your first ones take about a minute to make."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d de %2$d usados · Los looks gratuitos nunca caducan, y los primeros tardan alrededor de un minuto en crearse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d de %2$d usados · Os visuais gratuitos nunca expiram — e os primeiros levam cerca de um minuto para serem criados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d von %2$d verwendet · Kostenlose Looks verfallen nie — und deine ersten brauchen etwa eine Minute zur Erstellung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d sur %2$d utilisés · Les looks gratuits n'expirent jamais — et vos premiers prennent environ une minute à créer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d di %2$d usati · I look gratuiti non scadono mai — e i primi richiedono circa un minuto per essere creati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d van %2$d gebruikt · Gratis looks verlopen nooit — en je eerste duren ongeveer een minuut om te maken."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$d件中%1$d件使用済み · 無料ルックに有効期限はありません — 最初のものは作成に約1分かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$d개 중 %1$d개 사용됨 · 무료 룩은 만료되지 않습니다 — 그리고 첫 룩은 만드는 데 약 1분 정도 걸립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已使用 %2$d 个中的 %1$d 个 · 免费造型永不过期——你的第一批造型生成大约需要一分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已使用 %1$d / %2$d · 免費造型永不過期——而且你的第一批造型約需一分鐘製作。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استُخدم %1$d من %2$d · الإطلالات المجانية لا تنتهي صلاحيتها أبدًا — وتستغرق إطلالاتك الأولى نحو دقيقة لصنعها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$d में से %1$d इस्तेमाल हुए · मुफ़्त लुक कभी समाप्त नहीं होते — और आपके पहले लुक बनने में लगभग एक मिनट लगता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d dari %2$d digunakan · Tampilan gratis tidak pernah kedaluwarsa — dan yang pertama membutuhkan waktu sekitar satu menit untuk dibuat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d / %2$d kullanıldı · Ücretsiz görünümlerin süresi asla dolmaz — ve ilk görünümlerinin oluşturulması yaklaşık bir dakika sürer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykorzystano %1$d z %2$d · Darmowe wyglądy nigdy nie wygasają — a pierwsze powstają w około minutę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовано %1$d из %2$d · Бесплатные образы никогда не сгорают — а первые создаются около минуты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d av %2$d använda · Gratislooks går aldrig ut — och dina första tar ungefär en minut att skapa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ไป %1$d จาก %2$d · ลุคฟรีไม่มีวันหมดอายุ — และลุคแรก ๆ ใช้เวลาประมาณหนึ่งนาทีในการสร้าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã dùng %1$d trên %2$d · Diện mạo miễn phí không bao giờ hết hạn — và những diện mạo đầu tiên của bạn mất khoảng một phút để tạo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використано %1$d з %2$d · Безкоштовні образи ніколи не згорають — а перші створюються близько хвилини."
          }
        }
      }
    },
    "mim_upload_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong uploading your photos. No look was used. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal al subir tus fotos. No se ha usado ningún look. Inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado ao enviar suas fotos. Nenhum visual foi usado. Tente de novo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Hochladen deiner Fotos ist etwas schiefgegangen. Es wurde kein Look verwendet. Bitte versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose s'est mal passé lors de l'envoi de vos photos. Aucun look n'a été utilisé. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è andato storto nel caricamento delle tue foto. Nessun look è stato usato. Riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ging iets mis bij het uploaden van je foto's. Er is geen look gebruikt. Probeer het opnieuw."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真のアップロード中に問題が発生しました。ルックは使用されていません。再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 업로드하는 중 문제가 발생했습니다. 사용된 룩은 없습니다. 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传你的照片时出了点问题。没有使用任何造型。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳你的照片時發生問題。沒有使用任何造型。請重試。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ أثناء تحميل صورك. لم تُستخدم أي إطلالة. حاول مجددًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ोटो अपलोड करते समय कुछ गड़बड़ हो गई। कोई लुक इस्तेमाल नहीं हुआ। कृपया फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjadi kesalahan saat mengunggah fotomu. Tidak ada tampilan yang digunakan. Silakan coba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafların yüklenirken bir şeyler yanlış gitti. Hiçbir görünüm kullanılmadı. Lütfen tekrar dene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś poszło nie tak podczas przesyłania Twoich zdjęć. Nie użyto żadnego wyglądu. Spróbuj ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При загрузке ваших фотографий что-то пошло не так. Образ не был использован. Пожалуйста, попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något gick fel vid uppladdningen av dina foton. Ingen look användes. Försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดข้อผิดพลาดขณะอัปโหลดรูปภาพของคุณ ไม่ได้ใช้ลุคใด ๆ โปรดลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra lỗi khi tải ảnh của bạn lên. Không có diện mạo nào được dùng. Vui lòng thử lại."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щось пішло не так під час завантаження ваших фото. Жоден образ не використано. Спробуйте ще раз."
          }
        }
      }
    },
    "mim_upsell_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've seen yourself in %1$d %2$@. This is a new one, so it wears a standard photo. Subscribe, and RunWear makes your photo for every outfit in your weather ahead of time — you, on screen the moment you open the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya te has visto en %1$d %2$@. Este es nuevo, así que lleva una foto estándar. Suscríbete, y RunWear crea tu foto para cada conjunto de tu pronóstico por adelantado: tú, en pantalla en el momento en que abres la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já se viu em %1$d %2$@. Este é novo, então usa uma foto padrão. Assine, e o RunWear cria sua foto para todas as roupas do seu clima com antecedência — você, na tela no momento em que abre o app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dich in %1$d %2$@ gesehen. Das ist ein neues, also trägt es ein Standardfoto. Abonniere, und RunWear erstellt dein Foto für jedes Outfit bei deinem Wetter im Voraus — du, auf dem Bildschirm in dem Moment, in dem du die App öffnest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous êtes vu dans %1$d %2$@. Celle-ci est nouvelle, elle porte donc une photo standard. Abonnez-vous, et RunWear crée votre photo pour chaque tenue de votre météo à l'avance — vous, à l'écran dès que vous ouvrez l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti sei visto in %1$d %2$@. Questo è nuovo, quindi ha una foto standard. Abbonati e RunWear crea la tua foto per ogni outfit nel tuo meteo in anticipo — tu, sullo schermo nel momento in cui apri l'app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt jezelf gezien in %1$d %2$@. Dit is een nieuwe, dus hij heeft een standaardfoto. Abonneer je, en RunWear maakt je foto voor elke outfit in je komende weer vooraf — jij, op het scherm op het moment dat je de app opent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d件の%2$@で自分の姿を見てきました。これは新しいものなので、標準の写真が表示されます。登録すると、RunWearがあなたの天気に合わせたすべてのコーディネートの写真を事前に作成します — アプリを開いた瞬間、画面にあなたが写ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 %1$d%2$@에서 내 모습을 보셨습니다. 이것은 새로운 아웃핏이라 기본 사진을 입고 있습니다. 구독하면 RunWear가 앞으로의 날씨에 맞는 모든 아웃핏에 대해 미리 내 사진을 만들어 둡니다 — 앱을 여는 순간 화면에 내가 나타납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经在 %1$d 个%2$@中看到自己了。这是新的一套，所以它用的是标准照片。订阅后，RunWear 会提前为你天气中的每套穿搭生成你的照片——你打开应用的那一刻，你就在屏幕上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已經在 %1$d %2$@ 中看見自己了。這一套是新的，所以它用的是標準照片。訂閱後，RunWear 會提前為你天氣中的每一套裝扮製作你的照片——你打開 App 的那一刻，你就出現在畫面上。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد رأيت نفسك في %1$d %2$@. هذه إطلالة جديدة، لذا ترتدي صورة قياسية. اشترك، وسيصنع RunWear صورتك لكل إطلالة في طقسك مسبقًا — أنت، على الشاشة لحظة فتح التطبيق."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने खुद को %1$d %2$@ में देखा है। यह नई है, इसलिए इसमें मानक फ़ोटो है। सदस्यता लें, और RunWear आपके मौसम की हर आउटफ़िट के लिए आपकी फ़ोटो पहले से बनाता है — ऐप खोलते ही आप स्क्रीन पर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu telah melihat dirimu dalam %1$d %2$@. Ini yang baru, jadi ia memakai foto standar. Berlanggananlah, dan RunWear membuat fotomu untuk setiap outfit dalam cuacamu lebih awal — dirimu, di layar begitu kamu membuka aplikasi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendini %1$d %2$@ içinde gördün. Bu yeni bir kombin, bu yüzden standart bir fotoğraf taşıyor. Abone ol; RunWear, hava durumundaki her kombin için fotoğrafını önceden oluşturur — uygulamayı açtığın anda ekranda sen olursun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widziałeś siebie w %1$d %2$@. Ten jest nowy, więc ma standardowe zdjęcie. Wykup subskrypcję, a RunWear utworzy Twoje zdjęcie dla każdego stroju na Twoją pogodę z wyprzedzeniem — Ty, na ekranie w chwili otwarcia aplikacji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы видели себя в %1$d %2$@. Этот — новый, поэтому на нём стандартное фото. Оформите подписку, и RunWear будет заранее делать ваше фото для каждого комплекта под вашу погоду — вы на экране в тот момент, когда открываете приложение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har sett dig själv i %1$d %2$@. Det här är en ny, så den har ett standardfoto. Prenumerera, så skapar RunWear ditt foto för varje outfit i ditt väder i förväg — du, på skärmen i samma ögonblick som du öppnar appen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเห็นตัวเองใน %1$d %2$@ แล้ว ชุดนี้เป็นชุดใหม่ จึงใช้รูปมาตรฐาน สมัครสมาชิก แล้ว RunWear จะสร้างรูปของคุณสำหรับทุกชุดตามสภาพอากาศของคุณล่วงหน้า — คุณ บนหน้าจอทันทีที่คุณเปิดแอป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã nhìn thấy chính mình trong %1$d %2$@. Đây là trang phục mới, nên nó dùng ảnh tiêu chuẩn. Đăng ký, và RunWear sẽ tạo ảnh của bạn cho mọi trang phục theo thời tiết sắp tới của bạn trước — bạn, trên màn hình ngay khi bạn mở ứng dụng."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви бачили себе у %1$d %2$@. Це новий, тож на ньому стандартне фото. Підпишіться, і RunWear створюватиме ваше фото для кожного образу у вашій погоді заздалегідь — ви, на екрані в момент, коли відкриваєте застосунок."
          }
        }
      }
    },
