          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo look è stato creato per un meteo simile — quello esatto è in creazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze look is gemaakt voor vergelijkbaar weer — jouw exacte look wordt nu gemaakt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このルックは似た天気向けに作成されました — あなた専用のものを作成中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 룩은 비슷한 날씨를 위해 만들어졌습니다 — 정확한 룩은 만들어지는 중입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个造型是为类似天气生成的——你的专属造型正在生成中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個造型是為相似的天氣製作的——你專屬的那個正在製作中。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صُنعت هذه الإطلالة لطقس مشابه — إطلالتك الدقيقة تُصنع الآن."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह लुक मिलते-जुलते मौसम के लिए बनाया गया था — आपका सटीक लुक बनाया जा रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilan ini dibuat untuk cuaca serupa — tampilan persismu sedang dibuat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görünüm benzer hava durumu için oluşturuldu — seninki tam olarak oluşturuluyor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten wygląd został utworzony na podobną pogodę — Twój dokładny jest właśnie tworzony."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот образ был создан для похожей погоды — ваш точный образ сейчас создаётся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här looken skapades för liknande väder — din exakta skapas nu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลุคนี้สร้างสำหรับสภาพอากาศที่คล้ายกัน — ลุคที่ตรงของคุณกำลังสร้าง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Diện mạo này được tạo cho thời tiết tương tự — diện mạo chính xác của bạn đang được tạo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей образ створено для схожої погоди — ваш точний уже створюється."
          }
        }
      }
    },
