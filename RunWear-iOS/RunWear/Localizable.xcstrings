    "mim_look_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your look couldn't be made from these photos — tap to try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu look no se pudo crear a partir de estas fotos: toca para intentarlo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu visual não pôde ser criado a partir destas fotos — toque para tentar de novo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Look konnte aus diesen Fotos nicht erstellt werden — tippe, um es erneut zu versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre look n'a pas pu être créé à partir de ces photos — touchez pour réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile creare il tuo look da queste foto — tocca per riprovare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je look kon niet van deze foto's worden gemaakt — tik om het opnieuw te proberen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの写真からルックを作成できませんでした — タップして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진들로는 룩을 만들 수 없었습니다 — 탭하여 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法用这些照片生成你的造型——点按重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法用這些照片製作你的造型——點按重試。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر صنع إطلالتك من هذه الصور — انقر للمحاولة مجددًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन फ़ोटो से आपका लुक नहीं बनाया जा सका — फिर से कोशिश करने के लिए टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilanmu tidak dapat dibuat dari foto-foto ini — ketuk untuk mencoba lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünümün bu fotoğraflardan oluşturulamadı — tekrar denemek için dokun."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się utworzyć Twojego wyglądu z tych zdjęć — dotknij, aby spróbować ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш образ не удалось создать из этих фотографий — нажмите, чтобы попробовать снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din look kunde inte skapas från de här fotona — tryck för att försöka igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างลุคของคุณจากรูปเหล่านี้ไม่ได้ — แตะเพื่อลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tạo diện mạo của bạn từ những ảnh này — chạm để thử lại."
