    "settings_feedback_disclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus your message, exactly as written, under the category you picked. Nothing else — no health data, no location, no photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más tu mensaje, exactamente como lo escribiste, bajo la categoría que elegiste. Nada más: ni datos de salud, ni ubicación, ni fotos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Além da sua mensagem, exatamente como escrita, na categoria que você escolheu. Nada mais — sem dados de saúde, sem localização, sem fotos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus deine Nachricht, genau wie geschrieben, unter der Kategorie, die du gewählt hast. Sonst nichts — keine Gesundheitsdaten, kein Standort, keine Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus votre message, exactement tel qu'écrit, sous la catégorie que vous avez choisie. Rien d'autre — aucune donnée de santé, aucun lieu, aucune photo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più il tuo messaggio, esattamente come l'hai scritto, nella categoria che hai scelto. Nient'altro — nessun dato sulla salute, nessuna posizione, nessuna foto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus je bericht, precies zoals geschreven, onder de categorie die je koos. Niets anders — geen gezondheidsgegevens, geen locatie, geen foto's."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それに加えて、選んだカテゴリーのもとで、書いたままのメッセージ。それ以外のものは送りません — 健康データも、位置情報も、写真もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그리고 선택한 카테고리 아래에, 작성한 그대로의 메시지. 그 외에는 아무것도 없습니다 — 건강 데이터도, 위치도, 사진도 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加上你的消息，按原文，在你选择的类别下。没有其他内容——没有健康数据，没有位置，没有照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再加上你的訊息，完全照你寫的，放在你選的類別下。沒有其他東西——沒有健康資料、沒有位置、沒有照片。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة إلى رسالتك، كما كتبتها تمامًا، تحت الفئة التي اخترتها. لا شيء آخر — لا بيانات صحية، لا موقع، لا صور."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साथ ही आपका संदेश, बिल्कुल जैसा लिखा गया, आपकी चुनी श्रेणी के अंतर्गत। और कुछ नहीं — कोई स्वास्थ्य डेटा नहीं, कोई स्थान नहीं, कोई फ़ोटो नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditambah pesanmu, persis seperti yang ditulis, dalam kategori yang kamu pilih. Tidak ada yang lain — tanpa data kesehatan, tanpa lokasi, tanpa foto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıca mesajın, seçtiğin kategorinin altında, tam yazdığın gibi. Başka hiçbir şey — sağlık verisi yok, konum yok, fotoğraf yok."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus Twoja wiadomość, dokładnie tak, jak została napisana, w kategorii, którą wybrałeś. Nic więcej — bez danych zdrowotnych, bez lokalizacji, bez zdjęć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плюс ваше сообщение, точно как написано, под выбранной вами категорией. Ничего больше — никаких данных о здоровье, геолокации или фотографий."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus ditt meddelande, exakt som skrivet, under kategorin du valde. Inget annat — ingen hälsodata, ingen plats, inga foton."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พร้อมข้อความของคุณ ตรงตามที่เขียน ภายใต้หมวดหมู่ที่คุณเลือก ไม่มีอย่างอื่น — ไม่มีข้อมูลสุขภาพ ไม่มีตำแหน่ง ไม่มีรูปภาพ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cộng với tin nhắn của bạn, chính xác như đã viết, dưới danh mục bạn đã chọn. Không có gì khác — không dữ liệu sức khỏe, không vị trí, không ảnh."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плюс ваше повідомлення, точно як написано, у вибраній вами категорії. Нічого більше — без даних про здоров'я, без місцезнаходження, без фото."
          }
        }
      }
    },
