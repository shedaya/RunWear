    "tip_condition_clear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Great day for a run! Don't forget sunscreen if it's sunny."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Un gran día para correr! No olvides el protector solar si hace sol."
          }
        }
      }
    },
    "tip_condition_cloudy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overcast days can be great for longer runs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días cubiertos pueden ser ideales para carreras más largas."
          }
        }
      }
    },
    "tip_condition_drizzle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light rain can be refreshing. A cap helps keep rain off your face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lluvia ligera puede ser refrescante. Una gorra ayuda a que la lluvia no te dé en la cara."
          }
        }
      }
    },
    "tip_condition_foggy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wear bright, reflective clothing for visibility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva ropa brillante y reflectante para que te vean."
          }
        }
      }
    },
    "tip_condition_partly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjoy the cloud cover - it can help keep you cool."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disfruta la nubosidad: puede ayudarte a mantenerte fresco."
          }
        }
      }
    },
    "tip_condition_rain": {
      "extractionState": "manual",
