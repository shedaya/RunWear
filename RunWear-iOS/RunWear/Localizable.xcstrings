    "settings_feedback_send_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn't send. Check your connection and try again — or email it instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no se envió. Comprueba tu conexión e inténtalo de nuevo, o envíalo por correo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não foi enviado. Verifique sua conexão e tente de novo — ou envie por e-mail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das wurde nicht gesendet. Prüfe deine Verbindung und versuche es erneut — oder sende es stattdessen per E-Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne s'est pas envoyé. Vérifiez votre connexion et réessayez — ou envoyez-le par e-mail à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'invio non è riuscito. Controlla la connessione e riprova — oppure invialo via email."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat is niet verzonden. Controleer je verbinding en probeer het opnieuw — of e-mail het in plaats daarvan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信できませんでした。接続を確認して再試行してください — または代わりにメールで送ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송되지 않았습니다. 연결을 확인하고 다시 시도하세요 — 아니면 대신 이메일로 보내세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送失败。检查你的连接并重试——或者改为通过电子邮件发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送失敗。請檢查你的連線並重試——或改用電子郵件寄送。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم الإرسال. تحقق من اتصالك وحاول مجددًا — أو أرسلها بالبريد بدلًا من ذلك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह नहीं भेजा गया। अपना कनेक्शन जांचें और फिर से कोशिश करें — या इसके बजाय ईमेल करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Itu tidak terkirim. Periksa koneksimu dan coba lagi — atau kirim lewat email saja."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gönderilemedi. Bağlantını kontrol edip tekrar dene — veya bunun yerine e-postayla gönder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To się nie wysłało. Sprawdź połączenie i spróbuj ponownie — albo wyślij e-mailem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не отправилось. Проверьте соединение и попробуйте снова — или вместо этого отправьте по эл. почте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det skickades inte. Kontrollera din anslutning och försök igen — eller mejla det istället."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งไม่สำเร็จ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง — หรือส่งอีเมลแทน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn đó không gửi được. Kiểm tra kết nối của bạn và thử lại — hoặc gửi qua email thay thế."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не надіслалося. Перевірте з'єднання й спробуйте ще раз — або натомість надішліть email."
          }
        }
      }
    },
