    "onb_promise_1_phrase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One recommendation for the run you're about to take — feels-like, wind, and rain included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una recomendación para la carrera que estás a punto de hacer, con sensación térmica, viento y lluvia incluidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma recomendação para a corrida que você está prestes a fazer — sensação térmica, vento e chuva incluídos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Empfehlung für den Lauf, den du gleich machst — gefühlte Temperatur, Wind und Regen inklusive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une recommandation pour la course que vous allez faire — température ressentie, vent et pluie inclus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un consiglio per la corsa che stai per fare — temperatura percepita, vento e pioggia inclusi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén aanbeveling voor de loop die je gaat doen — gevoelstemperatuur, wind en regen inbegrepen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これから走るランのためのおすすめを1つ — 体感温度、風、雨も考慮します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 하려는 러닝을 위한 단 하나의 추천 — 체감 온도, 바람, 비까지 포함해서요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为你即将进行的跑步提供一条推荐——包括体感温度、风和雨。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為你即將進行的跑步提供一個推薦——包含體感溫度、風和雨。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توصية واحدة لجولة الجري التي توشك عليها — تشمل المحسوسة والرياح والمطر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो रन लेने वाले हैं उसके लिए एक सिफ़ारिश — जैसा महसूस होता है, हवा और बारिश समेत।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu rekomendasi untuk lari yang akan kamu lakukan — termasuk suhu terasa, angin, dan hujan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapmak üzere olduğun koşu için tek bir öneri — hissedilen sıcaklık, rüzgâr ve yağmur dahil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna rekomendacja na bieg, który właśnie planujesz — z uwzględnieniem temperatury odczuwalnej, wiatru i deszczu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна рекомендация для пробежки, на которую вы собираетесь, — с учётом ощущаемой температуры, ветра и дождя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En rekommendation för löpturen du är på väg att ta — känns som-temperatur, vind och regn inräknat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำแนะนำเดียวสำหรับวิ่งที่คุณกำลังจะออกไป — รวมอุณหภูมิที่รู้สึกเหมือน ลม และฝน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một gợi ý cho lần chạy bạn sắp thực hiện — bao gồm nhiệt độ cảm nhận, gió và mưa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна рекомендація для пробіжки, на яку ви збираєтеся — з урахуванням відчутної температури, вітру й дощу."
          }
        }
      }
    },
