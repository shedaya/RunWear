    "share_caption_scrapbook": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One for the scrapbook: %1$@, %2$@, %3$d° feels like, %4$@. The kit:\n%5$@\nEvery run, remembered — run, weather or not. #RunAnyWear · @runwear.ai"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno para el álbum: %1$@, %2$@, %3$d° de sensación térmica, %4$@. El equipo:\n%5$@\nCada carrera, recordada: corre, llueva o truene. #RunAnyWear · @runwear.ai"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um para o álbum: %1$@, %2$@, %3$d° de sensação térmica, %4$@. O kit:\n%5$@\nToda corrida, lembrada — corra, com qualquer clima. #RunAnyWear · @runwear.ai"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eines fürs Sammelalbum: %1$@, %2$@, %3$d° gefühlt, %4$@. Das Kit:\n%5$@\nJeder Lauf, erinnert — Laufen, egal welches Wetter. #RunAnyWear · @runwear.ai"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pour l'album : %1$@, %2$@, %3$d° ressenti, %4$@. L'équipement :\n%5$@\nChaque course, en mémoire — courez, qu'il fasse beau ou non. #RunAnyWear · @runwear.ai"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno per l'album: %1$@, %2$@, %3$d° percepiti, %4$@. Il kit:\\n%5$@\\nOgni corsa, ricordata — corri, qualunque sia il meteo. #RunAnyWear · @runwear.ai"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een voor het plakboek: %1$@, %2$@, %3$d° gevoelstemperatuur, %4$@. De uitrusting:\n%5$@\nElke loop, onthouden — hardlopen, weer of geen weer. #RunAnyWear · @runwear.ai"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクラップブック用に1枚：%1$@、%2$@、体感温度%3$d°、%4$@。ギア：\n%5$@\nすべてのランを記録 — 走ろう、天気にかかわらず。#RunAnyWear · @runwear.ai"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크랩북에 하나 추가: %1$@, %2$@, 체감 온도 %3$d°, %4$@. 장비:\n%5$@\n모든 러닝을 기억합니다 — 날씨와 상관없이 러닝. #RunAnyWear · @runwear.ai"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记入剪贴簿：%1$@，%2$@，体感温度 %3$d°，%4$@。装备：\n%5$@\n每一次跑步都被记住——跑步，无论天气如何。#RunAnyWear · @runwear.ai"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿再添一筆：%1$@，%2$@，體感溫度 %3$d°，%4$@。裝備：\n%5$@\n每一次跑步，都被記住——跑吧，天氣無阻。#RunAnyWear · @runwear.ai"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "واحدة لسجلّ القصاصات: %1$@، %2$@، %3$d° محسوسة، %4$@. الطقم:\n%5$@\nكل جولة جري، تُحفظ — اجرِ، مهما كان الطقس. #RunAnyWear · @runwear.ai"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रैपबुक के लिए एक: %1$@, %2$@, %3$d° जैसा महसूस होता है, %4$@। किट:\n%5$@\nहर रन, याद रखी गई — दौड़ें, मौसम हो या न हो। #RunAnyWear · @runwear.ai"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu untuk scrapbook: %1$@, %2$@, terasa seperti %3$d°, %4$@. Perlengkapannya:\\n%5$@\\nSetiap lari, diingat — lari, apa pun cuacanya. #RunAnyWear · @runwear.ai"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Albüm için bir tane: %1$@, %2$@, hissedilen %3$d°, %4$@. Ekipman:\n%5$@\nHer koşu hatırlanır — hava ne olursa olsun koş. #RunAnyWear · @runwear.ai"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden do albumu: %1$@, %2$@, odczuwalna %3$d°, %4$@. Zestaw:\n%5$@\nKażdy bieg zapamiętany — biegaj, bez względu na pogodę. #RunAnyWear · @runwear.ai"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё одна в альбом: %1$@, %2$@, ощущается как %3$d°, %4$@. Комплект:\\n%5$@\\nКаждая пробежка запомнена — бегите, в любую погоду. #RunAnyWear · @runwear.ai"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En för klippboken: %1$@, %2$@, känns som %3$d°, %4$@. Utrustningen:\n%5$@\nVarje löptur, ihågkommen — spring, oavsett väder. #RunAnyWear · @runwear.ai"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หนึ่งใบสำหรับสมุดภาพ: %1$@, %2$@, รู้สึกเหมือน %3$d°, %4$@ ชุด:\n%5$@\nทุกวิ่ง จดจำไว้ — วิ่ง ไม่ว่าสภาพอากาศจะเป็นอย่างไร #RunAnyWear · @runwear.ai"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một cho cuốn lưu niệm: %1$@, %2$@, cảm nhận như %3$d°, %4$@. Bộ đồ:\n%5$@\nMọi lần chạy, được ghi nhớ — chạy, bất kể thời tiết. #RunAnyWear · @runwear.ai"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один для альбому: %1$@, %2$@, відчувається як %3$d°, %4$@. Комплект:\n%5$@\nКожна пробіжка, запам'ятована — бігайте, незалежно від погоди. #RunAnyWear · @runwear.ai"
          }
        }
      }
    },
