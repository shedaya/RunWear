    "mim_flag_consequence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll stop showing this photo and make it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejaremos de mostrar esta foto y la crearemos de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos parar de mostrar esta foto e criá-la de novo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir zeigen dieses Foto nicht mehr und erstellen es neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous cesserons d'afficher cette photo et la recréerons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smetteremo di mostrare questa foto e la ricreeremo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We stoppen met het tonen van deze foto en maken hem opnieuw."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真の表示をやめ、作り直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진을 더 이상 표시하지 않고 다시 만들겠습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会停止显示这张照片并重新生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會停止顯示這張照片，並重新製作。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنتوقف عن عرض هذه الصورة ونصنعها مجددًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम यह फ़ोटो दिखाना बंद कर देंगे और इसे फिर से बनाएंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan berhenti menampilkan foto ini dan membuatnya lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu fotoğrafı göstermeyi bırakıp yeniden oluşturacağız."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przestaniemy pokazywać to zdjęcie i utworzymy je ponownie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы перестанем показывать это фото и создадим его заново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi slutar visa det här fotot och skapar det igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะหยุดแสดงรูปนี้และสร้างใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ ngừng hiển thị ảnh này và tạo lại nó."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми перестанемо показувати це фото й створимо його знову."
          }
        }
      }
    },
