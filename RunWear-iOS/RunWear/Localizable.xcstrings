          "stringUnit": {
            "state": "translated",
            "value": "UV ปานกลาง - แนะนำครีมกันแดดสำหรับวิ่งนาน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "UV vừa - nên dùng kem chống nắng cho những lần chạy dài hơn."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помірний УФ - сонцезахисний крем рекомендується для довших пробіжок."
          }
        }
      }
    },
    "tip_wind_light": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light wind can help cool you down during your run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El viento ligero puede ayudarte a refrescarte durante tu carrera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vento leve pode ajudar a refrescar você durante a corrida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leichter Wind kann helfen, dich während deines Laufs abzukühlen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vent léger peut aider à vous rafraîchir pendant votre course."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vento leggero può aiutarti a raffreddarti durante la corsa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lichte wind kan je helpen af te koelen tijdens je loop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そよ風はラン中に体を冷やすのに役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약한 바람은 러닝 중 체온을 식히는 데 도움이 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "微风能帮你在跑步时降温。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "微風能幫你在跑步時降溫。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرياح الخفيفة قد تساعدك على التبريد أثناء الجري."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हल्की हवा दौड़ के दौरान आपको ठंडा रखने में मदद कर सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angin ringan dapat membantumu mendinginkan tubuh saat berlari."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafif rüzgâr, koşu sırasında serinlemene yardımcı olabilir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lekki wiatr może pomóc Ci się ochłodzić podczas biegu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лёгкий ветер помогает охлаждаться во время пробежки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lätt vind kan hjälpa dig att kyla ner dig under löpturen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลมเบาช่วยให้คุณเย็นระหว่างวิ่ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gió nhẹ có thể giúp bạn hạ nhiệt trong khi chạy."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Легкий вітер може допомогти охолодити вас під час пробіжки."
          }
        }
      }
    },
    "tip_wind_start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start your run heading into the wind so you have it at your back when tired."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza tu carrera contra el viento para llevarlo a favor cuando estés cansado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece sua corrida contra o vento para tê-lo nas costas quando estiver cansado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte deinen Lauf gegen den Wind, damit du ihn im Rücken hast, wenn du müde bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez votre course face au vent pour l'avoir dans le dos quand vous serez fatigué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia la corsa controvento, così lo avrai alle spalle quando sarai stanco."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin je loop tegen de wind in, zodat je hem in je rug hebt als je moe bent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "向かい風に向かってランを始めると、疲れたときに追い風になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바람을 맞으며 러닝을 시작하면, 지쳤을 때 바람이 등을 밀어 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始跑步时迎风跑，这样累了的时候风在你背后。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跑步開始時迎風跑，這樣累的時候風就在你背後了。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ جولتك باتجاه الرياح لتكون خلفك عند التعب."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी रन हवा की ओर मुँह करके शुरू करें ताकि थकने पर हवा आपकी पीठ की ओर हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai larimu melawan arah angin agar angin berada di belakangmu saat lelah."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koşuna rüzgâra karşı başla; böylece yorulduğunda rüzgâr arkanda olur."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij bieg pod wiatr, aby mieć go za plecami, gdy będziesz zmęczony."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начинайте пробежку против ветра, чтобы на обратном пути, когда устанете, он дул вам в спину."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja löpturen mot vinden så att du har den i ryggen när du är trött."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มวิ่งโดยมุ่งหน้าเข้าหาลม เพื่อให้ลมอยู่ด้านหลังเมื่อคุณเหนื่อย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu lần chạy hướng vào gió để có gió sau lưng khi mệt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Починайте пробіжку проти вітру, щоб він був у спину, коли ви втомитеся."
          }
        }
      }
    },
