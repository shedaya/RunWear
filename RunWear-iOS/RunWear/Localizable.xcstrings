    "capture_camera_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off. You can turn it on in Settings — or pick a photo from your library instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara está desactivado. Puedes activarlo en Ajustes, o elegir una foto de tu biblioteca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera está desativado. Você pode ativá-lo em Configurações — ou escolher uma foto da sua biblioteca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugriff ist aus. Du kannst ihn in den Einstellungen einschalten — oder stattdessen ein Foto aus deiner Bibliothek wählen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à l'appareil photo est désactivé. Vous pouvez l'activer dans Réglages — ou choisir une photo dans votre bibliothèque à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alla fotocamera è disattivato. Puoi attivarlo nelle Impostazioni — oppure scegli una foto dalla tua libreria."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cameratoegang staat uit. Je kunt hem inschakelen in Instellingen — of kies in plaats daarvan een foto uit je bibliotheek."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスがオフです。設定でオンにできます — または代わりにライブラリから写真を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 접근이 꺼져 있습니다. 설정에서 켤 수 있습니다 — 아니면 대신 라이브러리에서 사진을 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机访问已关闭。你可以在“设置”中打开它——或者改为从你的相册中选择一张照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機存取已關閉。你可以在「設定」中開啟——或改從你的圖庫選一張照片。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الكاميرا معطّل. يمكنك تفعيله في الإعدادات — أو اختيار صورة من مكتبتك بدلًا من ذلك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा एक्सेस बंद है। आप इसे Settings में चालू कर सकते हैं — या इसके बजाय अपनी लाइब्रेरी से फ़ोटो चुन सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kamera nonaktif. Kamu dapat mengaktifkannya di Pengaturan — atau pilih foto dari pustakamu saja."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera erişimi kapalı. Ayarlar'dan açabilirsin — veya bunun yerine kitaplığından bir fotoğraf seçebilirsin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do aparatu jest wyłączony. Możesz włączyć go w Ustawieniach — albo zamiast tego wybrać zdjęcie z biblioteki."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к камере выключен. Его можно включить в настройках — или вместо этого выберите фото из библиотеки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraåtkomst är av. Du kan slå på den i Inställningar — eller välj ett foto från ditt bibliotek istället."
          }
        },
        "th": {
          "stringUnit": {
