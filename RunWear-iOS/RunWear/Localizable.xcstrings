    "mim_failed_explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This look couldn't be made, so the standard photo is shown here. Your other looks are unaffected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este look no se pudo crear, así que aquí se muestra la foto estándar. Tus demás looks no se ven afectados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este visual não pôde ser criado, então a foto padrão é mostrada aqui. Seus outros visuais não foram afetados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Look konnte nicht erstellt werden, also wird hier das Standardfoto gezeigt. Deine anderen Looks sind nicht betroffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce look n'a pas pu être créé, la photo standard est donc affichée ici. Vos autres looks ne sont pas affectés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo look non è stato creato, quindi qui è mostrata la foto standard. Gli altri look non ne risentono."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze look kon niet worden gemaakt, dus hier wordt de standaardfoto getoond. Je andere looks worden hier niet door beïnvloed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このルックは作成できなかったため、ここには標準の写真が表示されます。他のルックには影響ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 룩을 만들 수 없어서, 여기에 기본 사진이 표시됩니다. 다른 룩에는 영향이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个造型无法生成，所以这里显示标准照片。你的其他造型不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個造型無法製作，所以這裡顯示標準照片。你的其他造型不受影響。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر صنع هذه الإطلالة، لذا تُعرض الصورة القياسية هنا. إطلالاتك الأخرى غير متأثرة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह लुक नहीं बनाया जा सका, इसलिए यहाँ मानक फ़ोटो दिखाई गई है। आपके अन्य लुक अप्रभावित हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilan ini tidak dapat dibuat, jadi foto standar ditampilkan di sini. Tampilanmu yang lain tidak terpengaruh."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görünüm oluşturulamadı, bu yüzden burada standart fotoğraf gösteriliyor. Diğer görünümlerin etkilenmez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego wyglądu nie udało się utworzyć, więc pokazane jest tutaj standardowe zdjęcie. Pozostałe wyglądy nie są tym dotknięte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот образ не удалось создать, поэтому здесь показано стандартное фото. Остальные ваши образы не затронуты."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här looken kunde inte skapas, så standardfotot visas här. Dina andra looks påverkas inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างลุคนี้ไม่ได้ จึงแสดงรูปมาตรฐานที่นี่ ลุคอื่น ๆ ของคุณไม่ได้รับผลกระทบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Diện mạo này không thể tạo được, nên ảnh tiêu chuẩn được hiển thị ở đây. Các diện mạo khác của bạn không bị ảnh hưởng."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей образ не вдалося створити, тож тут показується стандартне фото. Інші ваші образи не зачеплені."
          }
        }
      }
    },
