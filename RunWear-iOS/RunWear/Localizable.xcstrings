    "shop_disclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These links open Amazon. As an Amazon Associate, RunWear may earn a commission from qualifying purchases, at no extra cost to you. It never changes the outfit we recommend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos enlaces abren Amazon. Como Asociado de Amazon, RunWear puede ganar una comisión por las compras que cumplan los requisitos, sin coste extra para ti. Nunca cambia el conjunto que recomendamos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes links abrem a Amazon. Como Associado da Amazon, o RunWear pode ganhar uma comissão sobre compras qualificadas, sem custo extra para você. Isso nunca altera a roupa que recomendamos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Links öffnen Amazon. Als Amazon-Partner kann RunWear eine Provision an qualifizierten Käufen verdienen, ohne Mehrkosten für dich. Es ändert nie das Outfit, das wir empfehlen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces liens ouvrent Amazon. En tant qu'associé Amazon, RunWear peut percevoir une commission sur les achats éligibles, sans coût supplémentaire pour vous. Cela ne change jamais la tenue que nous recommandons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi link aprono Amazon. In qualità di Associato Amazon, RunWear può guadagnare una commissione dagli acquisti idonei, senza costi aggiuntivi per te. Non cambia mai l'outfit che consigliamo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze links openen Amazon. Als Amazon-partner kan RunWear een commissie verdienen aan in aanmerking komende aankopen, zonder extra kosten voor jou. Het verandert nooit de outfit die we aanbevelen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのリンクはAmazonを開きます。Amazonアソシエイトとして、RunWearは対象の購入から手数料を得る場合がありますが、追加費用はかかりません。おすすめするコーディネートが変わることは決してありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 링크는 Amazon을 엽니다. Amazon 어소시에이트로서 RunWear는 적격 구매를 통해 수수료를 얻을 수 있으며, 사용자에게 추가 비용은 없습니다. 이는 추천하는 아웃핏을 절대 바꾸지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些链接会打开 Amazon。作为 Amazon Associate，RunWear 可能会从符合条件的购买中获得佣金，不会让你多花钱。它绝不会改变我们推荐的穿搭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些連結會開啟 Amazon。作為 Amazon 合作夥伴，RunWear 可能從符合資格的購買中賺取佣金，不會讓你多付任何費用。它絕不會改變我們推薦的裝扮。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفتح هذه الروابط Amazon. بصفته شريكًا في Amazon، قد يحقق RunWear عمولة من عمليات الشراء المؤهلة، دون أي تكلفة إضافية عليك. ولا يغيّر ذلك أبدًا الإطلالة التي نوصي بها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये लिंक Amazon खोलते हैं। Amazon Associate के रूप में, RunWear योग्य खरीदारी से कमीशन कमा सकता है, आपके लिए कोई अतिरिक्त लागत नहीं। यह हमारी सुझाई गई आउटफ़िट को कभी नहीं बदलता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan ini membuka Amazon. Sebagai Amazon Associate, RunWear dapat memperoleh komisi dari pembelian yang memenuhi syarat, tanpa biaya tambahan untukmu. Ini tidak pernah mengubah outfit yang kami rekomendasikan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bağlantılar Amazon'u açar. Amazon İş Ortağı olarak RunWear, uygun satın alımlardan sana ek maliyet olmadan komisyon kazanabilir. Bu, önerdiğimiz kombini asla değiştirmez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te linki otwierają Amazon. Jako partner Amazon, RunWear może zarobić prowizję od kwalifikujących się zakupów, bez dodatkowych kosztów dla Ciebie. Nigdy nie zmienia to stroju, który zalecamy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти ссылки открывают Amazon. Как партнёр Amazon, RunWear может получать комиссию с соответствующих требованиям покупок, без дополнительных затрат для вас. Это никогда не меняет комплект, который мы рекомендуем."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessa länkar öppnar Amazon. Som Amazon Associate kan RunWear tjäna en provision på kvalificerade köp, utan extra kostnad för dig. Det ändrar aldrig outfiten vi rekommenderar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์เหล่านี้เปิด Amazon ในฐานะ Amazon Associate, RunWear อาจได้รับค่าคอมมิชชันจากการซื้อที่เข้าเงื่อนไข โดยไม่มีค่าใช้จ่ายเพิ่มเติมสำหรับคุณ มันไม่เปลี่ยนชุดที่เราแนะนำ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các liên kết này mở Amazon. Với tư cách Cộng tác viên Amazon, RunWear có thể kiếm hoa hồng từ các giao dịch mua đủ điều kiện, không tốn thêm chi phí cho bạn. Nó không bao giờ thay đổi trang phục chúng tôi gợi ý."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці посилання відкривають Amazon. Як партнер Amazon, RunWear може заробляти комісію на відповідних покупках, без додаткових витрат для вас. Це ніколи не змінює образ, який ми рекомендуємо."
          }
        }
      }
    },
