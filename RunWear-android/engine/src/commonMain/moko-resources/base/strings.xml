    <string name="mim_f1_headline">See yourself in every outfit.</string>
    <string name="mim_f2_lead">Your recommendations, with you in the photo.</string>
    <string name="mim_f3_option_a_title">Make It Me</string>
    <string name="mim_f4_option_a_body">Upload 1 to 3 photos of yourself, and RunWear makes your outfit photos from them — starting with the one you\'re looking at.</string>
    <string name="mim_f5_option_a_button">Use my photos</string>
    <string name="mim_f6_option_b_title">Standard photos</string>
    <string name="mim_f7_option_b_body">Keep the photo library RunWear matches to your outfit and your weather. You can switch to Make It Me any time in Settings.</string>
    <string name="mim_f8_option_b_button">Use standard photos</string>
    <string name="mim_f9_footer">Either way, your recommendations don\'t change — only the photo does.</string>
    <string name="mim_c1a_consent_title">Before you add photos</string>
    <string name="mim_c1b_consent_body">RunWear will upload your photos to our server. They\'re used for one thing only: making pictures of you wearing your recommended outfits.\n\nYour photos are never used to train AI models. They\'re never shown to other users, never added to RunWear\'s standard photo library, and never shared.\n\nPictures made from your photos are kept only for you, so your outfits are ready when you open the app.\n\nYou can delete your photos and every picture made from them at any time: Settings → Make It Me → Delete my photos. Deleting is permanent and takes effect right away.\n\nNothing else is done with them.</string>
    <string name="mim_c1c_attestation">These photos are of me, and I am 18 or older.</string>
    <string name="mim_c1d_continue">Continue</string>
    <string name="mim_c1e_not_now">Not now</string>
    <string name="mim_c2a_capture_title">Add a photo of you</string>
    <string name="mim_c2b_capture_guidance">One photo of just your face: look at the camera, good light, no sunglasses. Your look is made from your face.</string>
    <string name="mim_c2e_source_dialog_title">Add a photo</string>
    <string name="mim_c2f_take_photo">Take photo</string>
    <string name="mim_c2g_choose_from_library">Choose from library</string>
