    <string name="mim_c2c_confirm_save">Save photos</string>
    <string name="mim_c2j_save_confirmed">Your photos are saved.</string>
    <string name="mim_c3a_reject_face_unclear">We can\'t see your face clearly in this one. Try a photo without sunglasses or a hat shadow.</string>
    <string name="mim_c3b_reject_multiple">This photo has more than one person in it. Pick one that\'s just you.</string>
    <string name="mim_c3c_reject_too_dark">Try facing a window or light, looking at the camera.</string>
    <string name="mim_c3d_reject_too_close">Hold the phone at arm\'s length, so your whole face fits with space around it.</string>
    <string name="mim_c3h_reject_face_too_small">Your face is small in that photo — A closer selfie works best — a mirror selfie is great too. Or let the camera guide you…</string>
    <string name="mim_c3i_reject_turned_away">Try facing a window or light, looking at the camera.</string>
    <string name="mim_c3e_retake_guided">Let\'s retake that one with the camera — face the light, keep your whole face inside the oval, and hold still.</string>
    <string name="mim_c3f_retake_upload">That photo can\'t be used. Retake with the camera, or choose a brighter photo that\'s just you, face forward.</string>
    <string name="mim_c3g_reject_rotated">This photo came out sideways. Retake it holding your phone upright, or pick a photo that\'s already upright.</string>
