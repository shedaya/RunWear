<?xml version="1.0" encoding="utf-8"?>
<!--
  RW-137 S4b (DESIGN §4.9): the anonymous session (access token,
  refresh token, user id) lives in the runwear_preferences
  DataStore — the file PreferencesRepository (shared module)
  creates under files/datastore/. It is excluded from BOTH cloud
  backup and device-to-device transfer: a migrated phone must
  behave exactly like a fresh install (new anonymous session, then
  RevenueCat restore + server-side adoption for Premium, or a
  fresh free start). Everything else in the app stays
  backup-eligible (android:allowBackup stays true) — only the
  session store is excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/runwear_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/runwear_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
