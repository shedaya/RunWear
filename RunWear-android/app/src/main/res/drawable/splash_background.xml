<?xml version="1.0" encoding="utf-8"?>
<!-- Starting window: the app's dark brand surface with the launcher mark
     centered, so a cold start opens on brand instead of the bare system
     default frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/runwear_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
