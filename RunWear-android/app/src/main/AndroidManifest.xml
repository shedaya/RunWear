<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- RW-168: legacy (API 26-28) MediaStore writes for "Save to
         photos"; scoped to the versions that need it — API 29+
         inserts are permission-free. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- GEN-5 (RW-28 item 16): the guided selfie is captured
         in-app (CameraX), so the app now declares the camera
         permission it previously avoided by handing off to the
         stock camera. The feature stays optional for devices
         without a camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".RunWearApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.RunWear">

        <!-- Safe-boot diagnostic (1.1.2; crash handler added 1.1.3):
             runs in the provider phase, before Application.onCreate and
             (via initOrder) ahead of androidx.startup's
             InitializationProvider. Uploads any stored crash report,
             installs the crash handler, and writes the first startup
             breadcrumb. -->
        <provider
            android:name=".diag.DiagBootProvider"
            android:authorities="${applicationId}.diagboot"
            android:exported="false"
            android:initOrder="1000" />

        <!-- Safe-boot diagnostic (1.1.2, kept in 1.1.3): WorkManager's androidx.startup
             initializer is a named suspect in the pre-Application crash
             window, so it is out of the boot path in this build.
             WorkManager initializes on demand instead, via the
             Configuration.Provider on RunWearApp. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RunWear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider for sharing debug logs -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Home Screen Widget -->
        <receiver
            android:name=".widget.OutfitWidgetReceiver"
            android:label="@string/widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/outfit_widget_info" />
        </receiver>

    </application>

</manifest>
