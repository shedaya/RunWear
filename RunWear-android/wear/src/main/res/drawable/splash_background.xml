<?xml version="1.0" encoding="utf-8"?>
<!-- Addendum 10 (Wear Play compliance, SPLASH): the Wear branded
     launch — the app icon at 48x48dp centred on a BLACK background.
     The icon bitmap is the shipped DARK launcher icon (dark #17262A
     ground, white shirt): @drawable/ic_splash_dark is a
     density-bucketed copy of the b2724c1 mipmap ic_launcher set
     (48px at mdpi through 192px at xxxhdpi — exactly 48dp at
     every density, drawn at intrinsic size centred on the black
     ground). A layer-list item width/height was tried first and
     does not constrain a bitmap item (it drew at 192px on an
     xhdpi face — caught by WearSplashTest), so the size lives in
     the density resources themselves. Per Addendum 9 the dark
     icon is unchanged; the new cream/pine icon is the light
     appearance and is NOT used here. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
        </shape>
    </item>
    <item android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_splash_dark" />
    </item>
</layer-list>
