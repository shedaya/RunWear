<?xml version="1.0" encoding="utf-8"?>
<!--
  RW-137 S4b (DESIGN §4.9): the runwear_preferences DataStore
  (PreferencesRepository, shared module) is excluded from BOTH
  cloud backup and device-to-device transfer, exactly as on the
  phone module — the session store never migrates. Everything
  else in the app stays backup-eligible (android:allowBackup
  stays true).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/runwear_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/runwear_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
